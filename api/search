 request is not valid. Correct what the response names and send it again. |","table":"table-3"},"10721":{"id":"/docs/api/latest/workflows-versions-get-31","page_id":"/docs/api/latest/workflows-versions-get","tags":[],"type":"text","url":"/docs/api/latest/workflows-versions-get#errors","content":"| Code              | HTTP status | Meaning                                                                                         |\n| ----------------- | ----------- | ----------------------------------------------------------------------------------------------- |\n| `VERSION_UNKNOWN` | 400         | This API does not serve the version you asked for. Send one of the dates in published_versions. |","table":"table-3"},"10722":{"id":"/docs/command-line","page_id":"/docs/command-line","type":"page","content":"Command line","breadcrumbs":["Docs"],"tags":[],"url":"/docs/command-line"},"10723":{"id":"/docs/command-line-0","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line","content":"Sign in, do everyday tasks, script with output and exit codes, and fix common problems."},"10724":{"id":"/docs/command-line-1","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#quick-start","content":"Quick start"},"10725":{"id":"/docs/command-line-2","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#sign-in-and-choose-an-organization","content":"Sign in and choose an organization"},"10726":{"id":"/docs/command-line-3","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#sign-in","content":"Sign in"},"10727":{"id":"/docs/command-line-4","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#choose-an-organization","content":"Choose an organization"},"10728":{"id":"/docs/command-line-5","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#everyday-tasks","content":"Everyday tasks"},"10729":{"id":"/docs/command-line-6","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#work-through-a-ticket","content":"Work through a ticket"},"10730":{"id":"/docs/command-line-7","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#find-tickets","content":"Find tickets"},"10731":{"id":"/docs/command-line-8","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#scripting","content":"Scripting"},"10732":{"id":"/docs/command-line-9","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#output-formats","content":"Output formats"},"10733":{"id":"/docs/command-line-10","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#pick-values-with---query","content":"Pick values with `--query`"},"10734":{"id":"/docs/command-line-11","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#long-lists","content":"Long lists"},"10735":{"id":"/docs/command-line-12","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#exit-codes","content":"Exit codes"},"10736":{"id":"/docs/command-line-13","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#retries-and-idempotency","content":"Retries and idempotency"},"10737":{"id":"/docs/command-line-14","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#errors-you-can-branch-on","content":"Errors you can branch on"},"10738":{"id":"/docs/command-line-15","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#agents","content":"Agents"},"10739":{"id":"/docs/command-line-16","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#the-agent-skill","content":"The agent skill"},"10740":{"id":"/docs/command-line-17","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#what-your-agent-may-do-without-asking","content":"What your agent may do without asking"},"10741":{"id":"/docs/command-line-18","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#what-your-agent-can-read","content":"What your agent can read"},"10742":{"id":"/docs/command-line-19","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#flags-and-bodies","content":"Flags and bodies"},"10743":{"id":"/docs/command-line-20","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#flags","content":"Flags"},"10744":{"id":"/docs/command-line-21","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#text-from-a-file-or-the-editor","content":"Text from a file or the editor"},"10745":{"id":"/docs/command-line-22","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#bodies","content":"Bodies"},"10746":{"id":"/docs/command-line-23","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#environment-variables","content":"Environment variables"},"10747":{"id":"/docs/command-line-24","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#troubleshooting","content":"Troubleshooting"},"10748":{"id":"/docs/command-line-25","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#sign-in-on-a-linux-server","content":"Sign in on a Linux server"},"10749":{"id":"/docs/command-line-26","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#commands","content":"Commands"},"10750":{"id":"/docs/command-line-27","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line","content":"Work with your STLabs organization from your terminal or a script."},"10751":{"id":"/docs/command-line-28","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#quick-start","content":"Install `stlabs` first. The Install page has the steps, and `stlabs --version` shows what you have. Your organization's slug is the short name after `/org/` in your STLabs web address. It is often different from the display name, so copy it from the address. Then sign in, choose your organization, and list the open tickets you requested:"},"10752":{"id":"/docs/command-line-29","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#quick-start","content":"`stlabs login` opens your browser. Sign in with your usual account. On a Linux server with no keyring running, `stlabs login --device` fails with `the keychain is not available`, so follow Sign in on a Linux server instead. On any other machine with no browser, use `stlabs login --device`. Sign in covers every way to sign in."},"10753":{"id":"/docs/command-line-30","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#quick-start","content":"`stlabs org set` does not check the slug, so a wrong one fails on the first command that calls the API. Troubleshooting shows what that looks like."},"10754":{"id":"/docs/command-line-31","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#quick-start","content":"The last command prints a table of your open tickets, newest first:"},"10755":{"id":"/docs/command-line-32","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#quick-start","content":"To let an AI agent use `stlabs`, run `stlabs setup`. See Agents."},"10756":{"id":"/docs/command-line-33","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in","content":"| To sign in with | Run            | Use it for         |\n| --------------- | -------------- | ------------------ |\n| A browser       | `stlabs login` | Your own computer. |","table":"table-0"},"10757":{"id":"/docs/command-line-34","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in","content":"| To sign in with | Run                     | Use it for                                                                                 |\n| --------------- | ----------------------- | ------------------------------------------------------------------------------------------ |\n| A code          | `stlabs login --device` | A machine with no browser. Open the address it prints on another device and type the code. |","table":"table-0"},"10758":{"id":"/docs/command-line-35","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in","content":"| To sign in with | Run                         | Use it for                         |\n| --------------- | --------------------------- | ---------------------------------- |\n| A token         | `stlabs login --with-token` | A script that already has a token. |","table":"table-0"},"10759":{"id":"/docs/command-line-36","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in","content":"Signing in saves a session in your keychain. On Linux, the keychain is a keyring that the Secret Service provides, and a server often has none: see Sign in on a Linux server. Before any command that calls the API, `stlabs` refreshes a browser or device session. You sign in again only when that session expires or is revoked. A token you paste with `--with-token` is stored as it is and is not refreshed, so replace it when it expires."},"10760":{"id":"/docs/command-line-37","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in","content":"`--with-token` reads the token from standard input. It refuses a token given as an argument, because the argument would end up in your shell history:"},"10761":{"id":"/docs/command-line-38","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in","content":"In CI and scripts, set `STLABS_TOKEN` instead. It takes precedence over the saved session. Get a token with `stlabs auth token` on a computer where you are signed in. It expires, so it suits short jobs."},"10762":{"id":"/docs/command-line-39","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in","content":"To check or end a session, use these commands:"},"10763":{"id":"/docs/command-line-40","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in","content":"| Command         | What it does                                                                                                                                                                                                                               |\n| --------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `stlabs status` | Shows the host, who is signed in and how (a browser, a device code, a pasted token or `STLABS_TOKEN`), the organization, and whether your agent may write without asking (`agent writes`, see Agents). Exits 1 when you are not signed in. |","table":"table-1"},"10764":{"id":"/docs/command-line-41","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in","content":"| Command         | What it does                                                                          |\n| --------------- | ------------------------------------------------------------------------------------- |\n| `stlabs whoami` | Prints your email on one line, or nothing when the token does not belong to a person. |","table":"table-1"},"10765":{"id":"/docs/command-line-42","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in","content":"| Command             | What it does                                                                                                                                                                                           |\n| ------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `stlabs auth token` | Prints the current access token for a script. It refreshes a browser session that is about to expire first. When the token comes from `STLABS_TOKEN` or `--with-token`, it prints that token as it is. |","table":"table-1"},"10766":{"id":"/docs/command-line-43","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in","content":"| Command         | What it does                                                                                                                                              |\n| --------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `stlabs logout` | Revokes a browser or device session and removes any saved sign-in from the keychain. A token you pasted is removed here but stays valid until it expires. |","table":"table-1"},"10767":{"id":"/docs/command-line-44","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#choose-an-organization","content":"Every call acts on one organization. `stlabs org set <slug>` saves it and `stlabs org status` shows it. `STLABS_ORGANIZATION` takes precedence over the saved slug, so CI and scripts can set it without writing a file."},"10768":{"id":"/docs/command-line-45","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#choose-an-organization","content":"The slug is not a secret. `stlabs` keeps it in a settings file, `~/.config/stlabs/config.json` by default, and not in the keychain. Environment variables lists how to use a different path."},"10769":{"id":"/docs/command-line-46","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#work-through-a-ticket","content":"These commands file a ticket, read it, edit it, comment, resolve it and list tickets. The last command files the first ticket again with the same idempotency key, which Retries and idempotency explains. Replace `dana@northwind.example` with the email of someone in your organization, or to file for yourself, use `--requester me` in place of `--requester-email`. A Linux machine without `uuidgen` can make a key with `cat /proc/sys/kernel/random/uuid`. The `northwind` organization is sample data, not a real organization."},"10770":{"id":"/docs/command-line-47","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#work-through-a-ticket","content":"The last command returns the first ticket's original response and files nothing new. Retries and idempotency explains why."},"10771":{"id":"/docs/command-line-48","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#work-through-a-ticket","content":"To open a ticket in your web browser, run `stlabs tickets get <id> --web`. It prints the address instead when there is no browser to open."},"10772":{"id":"/docs/command-line-49","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#find-tickets","content":"`stlabs tickets list` takes a text search and filters. They combine, and each one narrows the list. The newest tickets come first. A search that matches nothing succeeds with an empty list."},"10773":{"id":"/docs/command-line-50","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#find-tickets","content":"| Flag       | What it takes                                                                                        |\n| ---------- | ---------------------------------------------------------------------------------------------------- |\n| `--search` | Text to find in the title, description and ticket id. It ignores case and matches the text as typed. |","table":"table-2"},"10774":{"id":"/docs/command-line-51","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#find-tickets","content":"| Flag                        | What it takes                                                                                                                                                 |\n| --------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--assignee`, `--requester` | `me`, which is whoever is signed in (`stlabs status` shows who), or a person id. A person id is the `id` of the `assignee` or `requester` on a listed ticket. |","table":"table-2"},"10775":{"id":"/docs/command-line-52","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#find-tickets","content":"| Flag         | What it takes                                 |\n| ------------ | --------------------------------------------- |\n| `--priority` | A slug from `stlabs tickets priorities list`. |","table":"table-2"},"10776":{"id":"/docs/command-line-53","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#find-tickets","content":"| Flag      | What it takes                             |\n| --------- | ----------------------------------------- |\n| `--state` | A slug from `stlabs tickets states list`. |","table":"table-2"},"10777":{"id":"/docs/command-line-54","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#find-tickets","content":"| Flag                                  | What it takes                                                                                                                                                                                                                 |\n| ------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--created-after`, `--created-before` | A date such as `2026-10-01`, which means midnight UTC, or a full time such as `2026-10-01T00:00:00Z`. `--created-after` includes the time and `--created-before` does not. `--created-before 2026-10-31` leaves out the 31st. |","table":"table-2"},"10778":{"id":"/docs/command-line-55","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#output-formats","content":"On a terminal, `stlabs` shows what a person needs:"},"10779":{"id":"/docs/command-line-56","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#output-formats","content":"A command that lists records prints a table. It shows the columns you need to pick a record and shortens the longest column, such as the title, to fit the window."},"10780":{"id":"/docs/command-line-57","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#output-formats","content":"A command with a readable view, such as `stlabs tickets get`, shows one record."},"10781":{"id":"/docs/command-line-58","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#output-formats","content":"A command that changes something prints one line saying what changed, then the command to run next."},"10782":{"id":"/docs/command-line-59","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#output-formats","content":"Any other command prints JSON."},"10783":{"id":"/docs/command-line-60","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#output-formats","content":"The readable view and the success line appear only when the call succeeded. In a narrow window, a long text column moves to a second line. The row starts with `●` and its text follows `└`. Ticket ids in lists, in the ticket view and in the line after you file or change a ticket are links to the ticket, in terminals that can show links."},"10784":{"id":"/docs/command-line-61","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#output-formats","content":"When the output is piped or redirected, `stlabs` prints JSON on one line that ends with a newline. A `--query` result that is JSON is indented. `--output` picks another format on a terminal or in a pipe:"},"10785":{"id":"/docs/command-line-62","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#output-formats","content":"| `--output` | Prints                |\n| ---------- | --------------------- |\n| `json`     | The response as JSON. |","table":"table-3"},"10786":{"id":"/docs/command-line-63","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#output-formats","content":"| `--output` | Prints                |\n| ---------- | --------------------- |\n| `yaml`     | The response as YAML. |","table":"table-3"},"10787":{"id":"/docs/command-line-64","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#output-formats","content":"| `--output` | Prints                                                                                                                                                                                                                    |\n| ---------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `table`    | A list of objects as a table, or one record as a key-value table with nested keys joined by dots. The table is as wide as `$COLUMNS`, or the window, or 80 columns when piped with no `$COLUMNS`. Piped, it has no color. |","table":"table-3"},"10788":{"id":"/docs/command-line-65","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#output-formats","content":"| `--output` | Prints                                  |\n| ---------- | --------------------------------------- |\n| `lines`    | One value per line. It needs `--query`. |","table":"table-3"},"10789":{"id":"/docs/command-line-66","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#output-formats","content":"With no `--output`, a `--query` result that is text prints as text and anything else as JSON. An object that a query builds keeps its fields in the order the query lists them, in JSON, YAML and table columns. The fields of an object the API sent come back in alphabetical order."},"10790":{"id":"/docs/command-line-67","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#output-formats","content":"On a terminal, control characters in text printed with `--query` or `--output` show as escapes such as `\\x1b`. Tabs and line breaks stay as they are. Piped, the text is exactly as the API sent it."},"10791":{"id":"/docs/command-line-68","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"`--query` selects part of the response with a JMESPath expression. The expression starts from the whole response, which has `status`, `headers` and `body`. For example, `--query body.id` prints the id alone. The examples above use it to capture a new ticket's id."},"10792":{"id":"/docs/command-line-69","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"| To get    | Write             |\n| --------- | ----------------- |\n| One field | `--query body.id` |","table":"table-4"},"10793":{"id":"/docs/command-line-70","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"| To get                 | Write                                 |\n| ---------------------- | ------------------------------------- |\n| A field inside a field | `--query body.requester.display_name` |","table":"table-4"},"10794":{"id":"/docs/command-line-71","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"| To get             | Write                                                         |\n| ------------------ | ------------------------------------------------------------- |\n| One item of a list | `--query 'body.items[0]'`, or `'body.items[-1]'` for the last |","table":"table-4"},"10795":{"id":"/docs/command-line-72","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"| To get              | Write                                                 |\n| ------------------- | ----------------------------------------------------- |\n| The first two items | `--query 'body.items[0:2]'` (the end is not included) |","table":"table-4"},"10796":{"id":"/docs/command-line-73","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"| To get                  | Write                       |\n| ----------------------- | --------------------------- |\n| One field of every item | `--query 'body.items[].id'` |","table":"table-4"},"10797":{"id":"/docs/command-line-74","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"| To get               | Write                                  |\n| -------------------- | -------------------------------------- |\n| The items that match | `--query \"body.items[?state=='open']\"` |","table":"table-4"},"10798":{"id":"/docs/command-line-75","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"| To get                    | Write                                           |\n| ------------------------- | ----------------------------------------------- |\n| Some fields of every item | `--query 'body.items[].{id: id, state: state}'` |","table":"table-4"},"10799":{"id":"/docs/command-line-76","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"| To get         | Write                          |\n| -------------- | ------------------------------ |\n| How many items | `--query 'length(body.items)'` |","table":"table-4"},"10800":{"id":"/docs/command-line-77","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"| To get                  | Write                                                       |\n| ----------------------- | ----------------------------------------------------------- |\n| A header, or the status | `--query 'headers.\"Idempotent-Replayed\"'`, `--query status` |","table":"table-4"},"10801":{"id":"/docs/command-line-78","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"Inside the query:"},"10802":{"id":"/docs/command-line-79","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"Write text in a condition in single quotes, as in `state=='open'`."},"10803":{"id":"/docs/command-line-80","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"Double quotes name a field. That is how you write a header with a dash in its name."},"10804":{"id":"/docs/command-line-81","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"Write a number in a condition in backticks, as in `` [?n > `2`] ``."},"10805":{"id":"/docs/command-line-82","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"Compare with `==`, `!=`, `<`, `<=`, `>` and `>=`. Join conditions with `&&`, `||` and `!`."},"10806":{"id":"/docs/command-line-83","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"Functions such as `length`, `sort_by`, `contains` and `starts_with` are available."},"10807":{"id":"/docs/command-line-84","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"In your shell, put the whole query in single quotes. When the query itself holds single quotes, put it in double quotes instead, as in `\"body.items[?state=='open']\"`. Inside double quotes, the shell runs anything in backticks as a command, so put a backslash before each backtick of a number, as in ``\"body.items[?state=='open' && n > \\`2\\`]\"``."},"10808":{"id":"/docs/command-line-85","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"`stlabs` checks the syntax of the query, the functions it calls and where it starts before it sends anything. A query that cannot run exits with 2 and nothing is sent, so a typo never makes a change and then prints `null`."},"10809":{"id":"/docs/command-line-86","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"If the query does not fit the response, such as `length` of a number, `stlabs` prints nothing and exits 1. That is found only after the response arrives. When the command made a change, the change is still saved: `stlabs` says `Your change was saved` and names the command that shows it. A well-formed query for a field the response lacks prints `null`."},"10810":{"id":"/docs/command-line-87","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#long-lists","content":"A list that takes `--limit` returns a set number of records by default, 25 for `stlabs tickets list`. Run `stlabs <command> --help` to see whether a list takes `--limit` and `--all`. When more records exist, `stlabs` prints a note on stderr after the table or the JSON, whatever you set for `--query` or `--output`. Stdout keeps only what you asked for. The note looks like this:"},"10811":{"id":"/docs/command-line-88","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#long-lists","content":"A second line, not shown here, is the command that carries on from the last record: your command again, with its own `--cursor`."},"10812":{"id":"/docs/command-line-89","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#long-lists","content":"| To get                | Use                                                                                                             |\n| --------------------- | --------------------------------------------------------------------------------------------------------------- |\n| More than the default | `--limit 250`, which fetches 250 records a request at a time and prints them as one table or one JSON response. |","table":"table-5"},"10813":{"id":"/docs/command-line-90","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#long-lists","content":"| To get                    | Use     |\n| ------------------------- | ------- |\n| Every record, up to 1,000 | `--all` |","table":"table-5"},"10814":{"id":"/docs/command-line-91","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#long-lists","content":"| To get                  | Use                |\n| ----------------------- | ------------------ |\n| More than 1,000 records | `--all --max 5000` |","table":"table-5"},"10815":{"id":"/docs/command-line-92","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#long-lists","content":"| To get           | Use                                                                                                        |\n| ---------------- | ---------------------------------------------------------------------------------------------------------- |\n| The next records | The printed command, or `--cursor` with the `next_cursor` from the JSON. Keep the same search and filters. |","table":"table-5"},"10816":{"id":"/docs/command-line-93","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#long-lists","content":"A run fetches records a request at a time and stops after 100 requests. A request holds up to 100 records for `stlabs tickets list`, so a run reaches 10,000 records. Other lists have their own request size, which `stlabs <command> --help` names. `stlabs` refuses a larger `--limit` or `--max` before it sends anything. It says what the ceiling is."},"10817":{"id":"/docs/command-line-94","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#long-lists","content":"The JSON is `{\"items\": [...], \"next_cursor\": ...}`, whether it holds one page or many. `next_cursor` follows the last record printed and is `null` at the end of the list. With `--query`, keep the cursor in the result: `--query '{ids: body.items[].id, next: body.next_cursor}'` returns `next` as `null` at the end."},"10818":{"id":"/docs/command-line-95","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#long-lists","content":"A run that ends with records left still exits 0, because it returned all it was asked or allowed to. That includes a run that stopped at the page cap, where stderr says `Stopped after 100 pages`. Check `next_cursor` to know whether more remain."},"10819":{"id":"/docs/command-line-96","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#long-lists","content":"With `--all`, `stlabs` applies a `--query` or `--output` once, to the merged response. So `--all --query 'body.items[].id'` prints the ids from every page. A query over several pages reads the `status` and `headers` of the last page. If a page fails partway, `stlabs` exits with that failure's code, says how many records it fetched, and prints no combined response."},"10820":{"id":"/docs/command-line-97","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#exit-codes","content":"`stlabs help exit-codes` prints the same table."},"10821":{"id":"/docs/command-line-98","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#exit-codes","content":"| exit | meaning |\n| ---- | ------- |\n| 0    | success |","table":"table-6"},"10822":{"id":"/docs/command-line-99","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#exit-codes","content":"| exit | meaning                                                                                                                |\n| ---- | ---------------------------------------------------------------------------------------------------------------------- |\n| 1    | not signed in, no organization set, a response that could not be read (empty, or not from the API), or a network error |","table":"table-6"},"10823":{"id":"/docs/command-line-100","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#exit-codes","content":"| exit | meaning                                                                          |\n| ---- | -------------------------------------------------------------------------------- |\n| 2    | a usage error: an unknown command or option, a query or body that cannot be used |","table":"table-6"},"10824":{"id":"/docs/command-line-101","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#exit-codes","content":"| exit | meaning                                           |\n| ---- | ------------------------------------------------- |\n| 3    | the API answered with a redirect (a 3xx response) |","table":"table-6"},"10825":{"id":"/docs/command-line-102","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#exit-codes","content":"| exit | meaning                                                                                                                                                        |\n| ---- | -------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| 4    | the API refused the request (a 4xx response); retry only when the response says it is retryable, after any wait it names, and retry a change with the same key |","table":"table-6"},"10826":{"id":"/docs/command-line-103","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#exit-codes","content":"| exit | meaning                                                                  |\n| ---- | ------------------------------------------------------------------------ |\n| 5    | the API failed (a 5xx response); a change may or may not have been saved |","table":"table-6"},"10827":{"id":"/docs/command-line-104","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#exit-codes","content":"| exit | meaning                                                                                                                                                                  |\n| ---- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| 11   | the API no longer serves what this stlabs asks for: an API version it dropped (install the latest stlabs) or a command it removed (stlabs --help shows what replaces it) |","table":"table-6"},"10828":{"id":"/docs/command-line-105","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#exit-codes","content":"A 404, such as an unknown ticket, is exit 4. Exit 11 means the API changed, not that you made a mistake: see Troubleshooting."},"10829":{"id":"/docs/command-line-106","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#retries-and-idempotency","content":"**What `stlabs` retries.** A command that gets or lists records is retried twice on a 429 or 5xx response or a network error. It is not retried when the error says `retryable` is false."},"10830":{"id":"/docs/command-line-107","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#retries-and-idempotency","content":"It waits as long as `Retry-After` asks, up to 12 seconds, plus up to a quarter more so that callers refused together do not come back together. The wait is never more than 15 seconds."},"10831":{"id":"/docs/command-line-108","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#retries-and-idempotency","content":"When `Retry-After` asks for more than 12 seconds, `stlabs` does not wait. It exits with the response's own code (4 for a 429) and says how long to wait."},"10832":{"id":"/docs/command-line-109","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#retries-and-idempotency","content":"Each retry prints `warning: retry 1/2 in <wait>` on stderr."},"10833":{"id":"/docs/command-line-110","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#retries-and-idempotency","content":"A command that changes something is never retried automatically, and neither are `stlabs people availability search`, `stlabs queues search`, `stlabs tickets counts get` and `stlabs tickets translations list`, which read with a POST."},"10834":{"id":"/docs/command-line-111","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#retries-and-idempotency","content":"**After a failure.** A 5xx response or a network failure often leaves it unclear whether a change landed. `stlabs` names the read that shows it, such as `stlabs tickets comments list <ticket>` for a comment. It tells you to check before you run the change again. When the host cannot be reached at all, because the host refused the call or its name was not found, nothing was sent, and `stlabs` says so."},"10835":{"id":"/docs/command-line-112","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#retries-and-idempotency","content":"**Idempotency keys.** An idempotency key is a string that tells the API two requests are the same change. Every command that changes something is sent with one. `stlabs` makes a new key on each run, so running a command twice makes two changes. To make a retry safe, choose the key yourself with `--idempotency-key <key>`."},"10836":{"id":"/docs/command-line-113","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#retries-and-idempotency","content":"For a day after a key is first used, the same key never makes a second change:"},"10837":{"id":"/docs/command-line-114","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#retries-and-idempotency","content":"| You send                       | You get                                                                                                  |\n| ------------------------------ | -------------------------------------------------------------------------------------------------------- |\n| The same key and the same body | The original response, with the same `id` and status and the header `Idempotent-Replayed` set to `true`. |","table":"table-7"},"10838":{"id":"/docs/command-line-115","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#retries-and-idempotency","content":"| You send                                                                     | You get                                        |\n| ---------------------------------------------------------------------------- | ---------------------------------------------- |\n| The same key while the first attempt is unfinished or its outcome is unknown | A refusal that says to wait or to check first. |","table":"table-7"},"10839":{"id":"/docs/command-line-116","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#retries-and-idempotency","content":"| You send                          | You get                                             |\n| --------------------------------- | --------------------------------------------------- |\n| The same key and a different body | A refusal with the code `IDEMPOTENCY_KEY_MISMATCH`. |","table":"table-7"},"10840":{"id":"/docs/command-line-117","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#retries-and-idempotency","content":"When a change fails in a way that is safe to retry, `stlabs` prints the command to retry with, key included, on a line of its own. A refusal because too many keys are in use prints no command. The same key does not help until older keys expire."},"10841":{"id":"/docs/command-line-118","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#errors-you-can-branch-on","content":"A failed call exits non-zero, and never prints an error where a value should be. Where the error goes depends on how you ran the command:"},"10842":{"id":"/docs/command-line-119","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#errors-you-can-branch-on","content":"| How you ran it                              | What you get                                                                                                                                                                            |\n| ------------------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Piped, or with `--output`, and no `--query` | The error body on stdout. Piped, it is exactly as the API sent it. With `--output json` or `yaml` it has the same fields in that format. With `--output table` it is a key-value table. |","table":"table-8"},"10843":{"id":"/docs/command-line-120","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#errors-you-can-branch-on","content":"| How you ran it                                 | What you get                                                                                                             |\n| ---------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------ |\n| On a terminal, with no `--output` or `--query` | A line on stderr that says what went wrong and what to do, then `request id: <id>`. Quote that id when you ask for help. |","table":"table-8"},"10844":{"id":"/docs/command-line-121","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#errors-you-can-branch-on","content":"| How you ran it | What you get                                                                                                     |\n| -------------- | ---------------------------------------------------------------------------------------------------------------- |\n| With `--query` | Nothing on stdout, and the error body on stderr. This keeps an error from being read as the value you asked for. |","table":"table-8"},"10845":{"id":"/docs/command-line-122","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#errors-you-can-branch-on","content":"The exit code stays the same in every case. Check it, as in `ID=$(stlabs ...) || exit`, and not whether any output came back."},"10846":{"id":"/docs/command-line-123","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#errors-you-can-branch-on","content":"The error body has these fields:"},"10847":{"id":"/docs/command-line-124","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#errors-you-can-branch-on","content":"| Field  | What it holds                                               |\n| ------ | ----------------------------------------------------------- |\n| `code` | What went wrong, such as `NOT_FOUND`. Stable. Branch on it. |","table":"table-9"},"10848":{"id":"/docs/command-line-125","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#errors-you-can-branch-on","content":"| Field    | What it holds                             |\n| -------- | ----------------------------------------- |\n| `reason` | A finer cause, where one applies. Stable. |","table":"table-9"},"10849":{"id":"/docs/command-line-126","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#errors-you-can-branch-on","content":"| Field       | What it holds                     |\n| ----------- | --------------------------------- |\n| `retryable` | Whether a retry can work. Stable. |","table":"table-9"},"10850":{"id":"/docs/command-line-127","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#errors-you-can-branch-on","content":"| Field        | What it holds                                                         |\n| ------------ | --------------------------------------------------------------------- |\n| `next_steps` | What to do. Each step has a `kind`, such as `allowed_values`. Stable. |","table":"table-9"},"10851":{"id":"/docs/command-line-128","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#errors-you-can-branch-on","content":"| Field            | What it holds                                  |\n| ---------------- | ---------------------------------------------- |\n| `detail`, `hint` | Text for people. It can change in any release. |","table":"table-9"},"10852":{"id":"/docs/command-line-129","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#agents","content":"`stlabs setup` gets you and your AI agent ready in one command. On a terminal it:"},"10853":{"id":"/docs/command-line-130","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#agents","content":"Offers to sign you in. `--device` signs in with a code instead of the browser."},"10854":{"id":"/docs/command-line-131","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#agents","content":"Picks your organization. After a browser sign-in it uses the one you are signed into on the web. It asks only when that does not settle it."},"10855":{"id":"/docs/command-line-132","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#agents","content":"Installs the agent skill."},"10856":{"id":"/docs/command-line-133","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#agents","content":"Asks whether your agent may file tickets and add comments without asking you first."},"10857":{"id":"/docs/command-line-134","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#agents","content":"Ends by telling you what to ask your agent first, or the command still left to run."},"10858":{"id":"/docs/command-line-135","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#agents","content":"A step that is already done is skipped, so you can run `stlabs setup` again at any time. With `-y`, or with no terminal, it asks nothing and prints one `key: value` line for each step, with `next:` for what is left. Add `--output json` to print the result as JSON."},"10859":{"id":"/docs/command-line-136","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#agents","content":"`stlabs setup --status` prints the same lines and changes nothing. It exits 0 when the skill is current in every folder, and 1 otherwise. A missing sign-in or organization does not change the exit code. A relative `CLAUDE_CONFIG_DIR` is refused with exit code 2."},"10860":{"id":"/docs/command-line-137","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#the-agent-skill","content":"The skill is a set of instruction files that tells Claude Code and other agents how to use `stlabs`. Installing it sends nothing and never edits an agent's settings. It goes into these folders:"},"10861":{"id":"/docs/command-line-138","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#the-agent-skill","content":"`~/.claude/skills/stlabs-cli`"},"10862":{"id":"/docs/command-line-139","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#the-agent-skill","content":"`~/.agents/skills/stlabs-cli`"},"10863":{"id":"/docs/command-line-140","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#the-agent-skill","content":"When `CLAUDE_CONFIG_DIR` is set to an absolute path, the first folder is `$CLAUDE_CONFIG_DIR/skills/stlabs-cli`. If `setup` creates `~/.claude/skills` for the first time, a Claude Code session that is already running needs `/reload-skills`."},"10864":{"id":"/docs/command-line-141","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#the-agent-skill","content":"`--status` reports one of four states for each folder:"},"10865":{"id":"/docs/command-line-142","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#the-agent-skill","content":"| State   | What `setup` does |\n| ------- | ----------------- |\n| Current | Nothing.          |","table":"table-10"},"10866":{"id":"/docs/command-line-143","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#the-agent-skill","content":"| State    | What `setup` does |\n| -------- | ----------------- |\n| Outdated | Replaces it.      |","table":"table-10"},"10867":{"id":"/docs/command-line-144","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#the-agent-skill","content":"| State                          | What `setup` does                                                                                                                                    |\n| ------------------------------ | ---------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Changed since it was installed | On a terminal, asks before it replaces your edited copy. `-y` replaces it without asking. With no terminal and no `-y`, it leaves the copy as it is. |","table":"table-10"},"10868":{"id":"/docs/command-line-145","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#the-agent-skill","content":"| State         | What `setup` does |\n| ------------- | ----------------- |\n| Not installed | Installs it.      |","table":"table-10"},"10869":{"id":"/docs/command-line-146","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#the-agent-skill","content":"If you keep an edited copy, `setup` skips the question about tickets and comments."},"10870":{"id":"/docs/command-line-147","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#what-your-agent-may-do-without-asking","content":"`setup` asks whether your agent may file tickets and add comments without asking you first:"},"10871":{"id":"/docs/command-line-148","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#what-your-agent-may-do-without-asking","content":"| Answer                  | What the agent does                              |\n| ----------------------- | ------------------------------------------------ |\n| `confirm` (the default) | Asks before it files a ticket or adds a comment. |","table":"table-11"},"10872":{"id":"/docs/command-line-149","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#what-your-agent-may-do-without-asking","content":"| Answer    | What the agent does                    |\n| --------- | -------------------------------------- |\n| `routine` | Files tickets and comments on its own. |","table":"table-11"},"10873":{"id":"/docs/command-line-150","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#what-your-agent-may-do-without-asking","content":"Whatever you choose, the skill tells the agent to ask before it resolves, updates or deletes anything, or makes a bulk change. The skill only asks the agent to stop. Your agent tool's own permission prompts are the check that holds."},"10874":{"id":"/docs/command-line-151","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#what-your-agent-may-do-without-asking","content":"Run `setup` again and it shows your answer and asks whether to change it. To set it without a question, use `--agent-writes confirm` or `--agent-writes routine`. With `-y`, `setup` keeps the setting you have, or `confirm` if there is none. `stlabs status` and `stlabs setup --status` show it as `agent writes`."},"10875":{"id":"/docs/command-line-152","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#what-your-agent-can-read","content":"`stlabs agent schema` prints the commands of the `stlabs` installed on this machine. An agent can read them even when its skill is older than `stlabs`. It needs no sign-in and sends nothing. It prints JSON when piped or with `--output json`, and text on a terminal."},"10876":{"id":"/docs/command-line-153","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#what-your-agent-can-read","content":"| Command                              | Prints                                                                      |\n| ------------------------------------ | --------------------------------------------------------------------------- |\n| `stlabs agent schema tickets create` | One command: its flags, fields, examples, and when it is safe to run again. |","table":"table-12"},"10877":{"id":"/docs/command-line-154","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#what-your-agent-can-read","content":"| Command                       | Prints                                      |\n| ----------------------------- | ------------------------------------------- |\n| `stlabs agent schema tickets` | A group: each command with its field names. |","table":"table-12"},"10878":{"id":"/docs/command-line-155","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#what-your-agent-can-read","content":"| Command                               | Prints                                                |\n| ------------------------------------- | ----------------------------------------------------- |\n| `stlabs agent schema --search <word>` | The commands whose names or summaries match the word. |","table":"table-12"},"10879":{"id":"/docs/command-line-156","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#what-your-agent-can-read","content":"Run without a name, it lists every command of `stlabs`. For commands that `stlabs` answers itself, such as `login` and `setup`, it prints their usage."},"10880":{"id":"/docs/command-line-157","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#flags","content":"A command takes only the options its `--help` lists. `stlabs <command> --help` lists every flag, the keys of each object and the field each flag sets."},"10881":{"id":"/docs/command-line-158","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#flags","content":"Every field that takes a value has a flag, named after the field with `_` written as `-`: `--title`, `--priority`, `--queue`, `--assignee` and the rest."},"10882":{"id":"/docs/command-line-159","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#flags","content":"| For                              | Write                                                                                     |\n| -------------------------------- | ----------------------------------------------------------------------------------------- |\n| A field that offers alternatives | A flag named after the alternative you pick. `stlabs tickets transition` takes `--state`. |","table":"table-13"},"10883":{"id":"/docs/command-line-160","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#flags","content":"| For                                   | Write                                                           |\n| ------------------------------------- | --------------------------------------------------------------- |\n| A list you can add to and remove from | A flag for each verb: `--add-follower` and `--remove-follower`. |","table":"table-13"},"10884":{"id":"/docs/command-line-161","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#flags","content":"| For                       | Write                                                                                                                                                                              |\n| ------------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| The settings of an object | One flag named for the object, with a key for each setting: `--awaiting-reply close-hours=48 --awaiting-reply then=cancel`. The value is everything after the first `=`, as typed. |","table":"table-13"},"10885":{"id":"/docs/command-line-162","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#flags","content":"| For                               | Write                                                                                  |\n| --------------------------------- | -------------------------------------------------------------------------------------- |\n| A field that holds several values | The flag once for each value. Ids may also be separated by commas. Free text never is. |","table":"table-13"},"10886":{"id":"/docs/command-line-163","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#flags","content":"| For                   | Write                                                  |\n| --------------------- | ------------------------------------------------------ |\n| A true or false field | The flag alone for true, and `--flag=false` for false. |","table":"table-13"},"10887":{"id":"/docs/command-line-164","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#flags","content":"| For                            | Write                                                   |\n| ------------------------------ | ------------------------------------------------------- |\n| A field that can be left empty | `--clear <field>` unsets it. Repeat it for more fields. |","table":"table-13"},"10888":{"id":"/docs/command-line-165","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#flags","content":"`stlabs` sends the value of a flag exactly as given. Commas, colons, quotes, `@me` and text that looks like a number need no quoting except your shell's. A body follows different quoting rules: see Bodies."},"10889":{"id":"/docs/command-line-166","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#text-from-a-file-or-the-editor","content":"A comment, a description, a reason or a note takes `--body`, `--description`, `--reason` or `--note`. Add `-file` to the name to read the text from a file, or from standard input with `-`. The text is sent exactly as given, with its commas, quotes, brackets and line breaks."},"10890":{"id":"/docs/command-line-167","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#text-from-a-file-or-the-editor","content":"Keep text in one shell argument, as in `--body 'Thanks, that fixed it'`. To read a comment from a pipe, run `stlabs tickets comments create \"$ID\" --body-file -`."},"10891":{"id":"/docs/command-line-168","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#text-from-a-file-or-the-editor","content":"On a terminal, a comment with no text opens the editor named by `VISUAL` or `EDITOR`. With neither set, or with no terminal, the command stops with exit code 2 and says how to give the text."},"10892":{"id":"/docs/command-line-169","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#bodies","content":"A body is one argument of `field: value` pairs separated by commas. It goes after the other arguments, as in `stlabs tickets update <ticket> 'title: \"Filed, then edited\"'`. It is the only way to give a field that holds an object, such as `business_hours`."},"10893":{"id":"/docs/command-line-170","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#bodies","content":"Put the whole body in single quotes."},"10894":{"id":"/docs/command-line-171","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#bodies","content":"Put a value in double quotes if it contains a comma, starts with `@`, looks like a number, is `true`, `false` or `null`, or starts with `[` or `{`. Unquoted, those are sent as something other than text."},"10895":{"id":"/docs/command-line-172","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#bodies","content":"Give a field by its flag or in the body, not both."},"10896":{"id":"/docs/command-line-173","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#bodies","content":"A word after the body is refused rather than added to it."},"10897":{"id":"/docs/command-line-174","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#bodies","content":"| You want             | Write                           |\n| -------------------- | ------------------------------- |\n| A title with a comma | `'title: \"Filed, then edited\"'` |","table":"table-14"},"10898":{"id":"/docs/command-line-175","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#bodies","content":"| You want                 | Write            |\n| ------------------------ | ---------------- |\n| A title that is a number | `'title: \"123\"'` |","table":"table-14"},"10899":{"id":"/docs/command-line-176","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#bodies","content":"| You want                      | Write             |\n| ----------------------------- | ----------------- |\n| A title that is the word true | `'title: \"true\"'` |","table":"table-14"},"10900":{"id":"/docs/command-line-177","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#bodies","content":"| You want                                    | Write               |\n| ------------------------------------------- | ------------------- |\n| An assignee of `@me`, which starts with `@` | `'assignee: \"@me\"'` |","table":"table-14"},"10901":{"id":"/docs/command-line-178","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#environment-variables","content":"| Variable       | What it does                                   |\n| -------------- | ---------------------------------------------- |\n| `STLABS_TOKEN` | The token to use instead of the saved session. |","table":"table-15"},"10902":{"id":"/docs/command-line-179","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#environment-variables","content":"| Variable              | What it does                                                           |\n| --------------------- | ---------------------------------------------------------------------- |\n| `STLABS_ORGANIZATION` | The organization to act on. It takes precedence over `stlabs org set`. |","table":"table-15"},"10903":{"id":"/docs/command-line-180","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#environment-variables","content":"| Variable        | What it does                                                                                              |\n| --------------- | --------------------------------------------------------------------------------------------------------- |\n| `STLABS_CONFIG` | The path of the settings file. The default is `config.json` in a `stlabs` folder under `XDG_CONFIG_HOME`. |","table":"table-15"},"10904":{"id":"/docs/command-line-181","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#environment-variables","content":"| Variable          | What it does                                                                                         |\n| ----------------- | ---------------------------------------------------------------------------------------------------- |\n| `XDG_CONFIG_HOME` | Where the `stlabs` settings folder goes when `STLABS_CONFIG` is not set. The default is `~/.config`. |","table":"table-15"},"10905":{"id":"/docs/command-line-182","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#environment-variables","content":"| Variable            | What it does                                                                                |\n| ------------------- | ------------------------------------------------------------------------------------------- |\n| `CLAUDE_CONFIG_DIR` | An absolute path that replaces `~/.claude` for the agent skill. A relative path is refused. |","table":"table-15"},"10906":{"id":"/docs/command-line-183","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#environment-variables","content":"| Variable   | What it does                                                                                                            |\n| ---------- | ----------------------------------------------------------------------------------------------------------------------- |\n| `NO_COLOR` | Any value except an empty one turns color off. This applies to tables and to `stlabs setup`. `TERM=dumb` does the same. |","table":"table-15"},"10907":{"id":"/docs/command-line-184","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#environment-variables","content":"| Variable            | What it does                                                                                          |\n| ------------------- | ----------------------------------------------------------------------------------------------------- |\n| `STLABS_HYPERLINKS` | `0` turns links off anywhere and `1` turns them on anywhere. By default, links follow the color rule. |","table":"table-15"},"10908":{"id":"/docs/command-line-185","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#environment-variables","content":"| Variable            | What it does                                                                       |\n| ------------------- | ---------------------------------------------------------------------------------- |\n| `STLABS_NO_NOTICES` | `1` hides every notice, including the warning about a command the API is retiring. |","table":"table-15"},"10909":{"id":"/docs/command-line-186","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#environment-variables","content":"| Variable           | What it does                                                                                                                                                                                                                                |\n| ------------------ | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `STLABS_TELEMETRY` | `stlabs` sends crash reports, and looks once a day for a notice, without being asked. `0` stops both, so no update notice is shown either. `print` shows each crash report without sending it. `DO_NOT_TRACK=1` has the same effect as `0`. |","table":"table-15"},"10910":{"id":"/docs/command-line-187","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#environment-variables","content":"| Variable  | What it does                                                                                                            |\n| --------- | ----------------------------------------------------------------------------------------------------------------------- |\n| `COLUMNS` | The width of tables, on a terminal and when piped. Without it, tables use the window's width, or 80 columns when piped. |","table":"table-15"},"10911":{"id":"/docs/command-line-188","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#environment-variables","content":"| Variable           | What it does                                      |\n| ------------------ | ------------------------------------------------- |\n| `VISUAL`, `EDITOR` | The editor that opens for a comment with no text. |","table":"table-15"},"10912":{"id":"/docs/command-line-189","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"| You see                 | Why                                                                                            | What to do                                 |\n| ----------------------- | ---------------------------------------------------------------------------------------------- | ------------------------------------------ |\n| `stlabs: not signed in` | You have no saved session, and `STLABS_TOKEN` is not set. `stlabs` sends nothing. Exit code 1. | Run `stlabs login`, or set `STLABS_TOKEN`. |","table":"table-16"},"10913":{"id":"/docs/command-line-190","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"| You see                                                              | Why                                                     | What to do          |\n| -------------------------------------------------------------------- | ------------------------------------------------------- | ------------------- |\n| `stlabs: your sign-in has expired or was revoked. Run stlabs login.` | Your saved session expired or was revoked. Exit code 1. | Run `stlabs login`. |","table":"table-16"},"10914":{"id":"/docs/command-line-191","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"| You see                                                                 | Why                                                                                                                                                                                                       | What to do                                                    |\n| ----------------------------------------------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ------------------------------------------------------------- |\n| A 401 from the API that ends `Run stlabs login, or check STLABS_TOKEN.` | The token in `STLABS_TOKEN` or your session is not accepted. Exit code 4. When the output is piped, the line reads `stlabs: the API refused the token (expired or invalid).` followed by the same advice. | Run `stlabs login` to sign in again, or check `STLABS_TOKEN`. |","table":"table-16"},"10915":{"id":"/docs/command-line-192","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"| You see                       | Why                                                                                               | What to do                   |\n| ----------------------------- | ------------------------------------------------------------------------------------------------- | ---------------------------- |\n| `stlabs: no organization set` | No saved organization, and `STLABS_ORGANIZATION` is not set. `stlabs` sends nothing. Exit code 1. | Run `stlabs org set <slug>`. |","table":"table-16"},"10916":{"id":"/docs/command-line-193","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"| You see                                                                       | Why                                                                                                                                         | What to do                                                                                              |\n| ----------------------------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------- | ------------------------------------------------------------------------------------------------------- |\n| A 403 `PERMISSION_DENIED` that says the slug is not one of your organizations | `stlabs org set` saves a slug without checking it, so a wrong one fails on the first call to the API. A display name is often not the slug. | Take the slug from the name after `/org/` in your STLabs web address, then run `stlabs org set <slug>`. |","table":"table-16"},"10917":{"id":"/docs/command-line-194","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"| You see                                                                 | Why                                      | What to do                                                                                                                                                                                                                         |\n| ----------------------------------------------------------------------- | ---------------------------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| A 403 with the code `PERMISSION_DENIED`, which says you are not allowed | You may have the wrong organization set. | Run `stlabs org status`, then `stlabs org set <slug>` if it is wrong. `stlabs` leaves this hint out when the refusal is about one field or one ticket, such as changing a title, because another organization would not change it. |","table":"table-16"},"10918":{"id":"/docs/command-line-195","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"| You see                                        | Why                                          | What to do                             |\n| ---------------------------------------------- | -------------------------------------------- | -------------------------------------- |\n| A 403 with the code `ORGANIZATION_NOT_ENABLED` | The API is not set up for your organization. | Email support@stlabs.com to set it up. |","table":"table-16"},"10919":{"id":"/docs/command-line-196","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"| You see                                           | Why                                                                                                           | What to do                                                            |\n| ------------------------------------------------- | ------------------------------------------------------------------------------------------------------------- | --------------------------------------------------------------------- |\n| A 403 with the code `ELIGIBILITY_REQUIRES_PERSON` | You are not signed in as a person in the organization you chose, often because the wrong organization is set. | Run `stlabs org status`, and sign in as yourself with `stlabs login`. |","table":"table-16"},"10920":{"id":"/docs/command-line-197","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"| You see                   | Why                         | What to do                                                                                                                |\n| ------------------------- | --------------------------- | ------------------------------------------------------------------------------------------------------------------------- |\n| `stlabs: unknown command` | The command does not exist. | Run `stlabs --help`. `stlabs` suggests the closest command when there is one, as in `Did you mean 'stlabs tickets list'?` |","table":"table-16"},"10921":{"id":"/docs/command-line-198","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"| You see                                                        | Why                              | What to do                                   |\n| -------------------------------------------------------------- | -------------------------------- | -------------------------------------------- |\n| Exit code 11 and a line that says the command has been removed | The API has retired the command. | Run `stlabs --help` to see what replaces it. |","table":"table-16"},"10922":{"id":"/docs/command-line-199","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"| You see                                                        | Why                                                         | What to do                   |\n| -------------------------------------------------------------- | ----------------------------------------------------------- | ---------------------------- |\n| Exit code 11 and a line that says to install the latest stlabs | The API has retired the API version this `stlabs` asks for. | Install the latest `stlabs`. |","table":"table-16"},"10923":{"id":"/docs/command-line-200","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"| You see                                                           | Why                                                                | What to do                               |\n| ----------------------------------------------------------------- | ------------------------------------------------------------------ | ---------------------------------------- |\n| `warning: 'stlabs tickets list' will stop working on 2027-03-14.` | The API is retiring that command. It keeps working until that day. | Install the latest `stlabs` before then. |","table":"table-16"},"10924":{"id":"/docs/command-line-201","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"| You see                                                                                                   | Why                                                                                                                                                                           | What to do                                                                                                         |\n| --------------------------------------------------------------------------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------ |\n| `stlabs: the keychain is not available.` Then, for a command that calls the API, `stlabs: not signed in.` | `stlabs` cannot read the keychain, so it finds no session. On Linux, no Secret Service is running, which is usual on a server. On macOS, the keychain is locked. Exit code 1. | On Linux, see Sign in on a Linux server. On macOS, unlock the keychain. In both, `STLABS_TOKEN` works without one. |","table":"table-16"},"10925":{"id":"/docs/command-line-202","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"When the API has retired a command or an API version, a terminal shows a short line. Piped, or with `--output`, the whole error body is printed, and the exit code is the signal."},"10926":{"id":"/docs/command-line-203","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"A retiring command prints its warning once per run, on stderr. A command the API is retiring without a date prints the same line, saying it is going away. A command the API has already retired does not warn. It fails with exit code 11. The warning is a notice, so it is not shown when output is piped or `--output` is given. `STLABS_NO_NOTICES=1` hides it."},"10927":{"id":"/docs/command-line-204","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in-on-a-linux-server","content":"On Linux, `stlabs` keeps your session in a keyring that the Secret Service provides. `stlabs login` with no terminal stops with `no token given`. `stlabs login --device` fails with `the keychain is not available` while no keyring is running. You have two ways to sign in."},"10928":{"id":"/docs/command-line-205","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in-on-a-linux-server","content":"**Copy a token from your own computer.** On a computer with a browser, run `stlabs login`, then run `stlabs auth token`. On the server, set its output as `STLABS_TOKEN` and set `STLABS_ORGANIZATION`. The token expires, so this suits a short job."},"10929":{"id":"/docs/command-line-206","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in-on-a-linux-server","content":"**Run a keyring on the server.** On Debian or Ubuntu, install the packages, start a shell under `dbus-run-session`, and unlock a keyring with a passphrase you choose. The passphrase is typed at a prompt, so it stays out of your shell history:"},"10930":{"id":"/docs/command-line-207","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in-on-a-linux-server","content":"Run your `stlabs` commands in that shell. The keyring lives in `~/.local/share/keyrings`, locked with that passphrase, and is open only while the shell runs. The next time you log in to the server, start the shell the same way (`dbus-run-session -- bash`, then the `read` and `eval` lines) with the same passphrase. You stay signed in."},"10931":{"id":"/docs/command-line-208","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in-on-a-linux-server","content":"To run a command without a shell that stays open, such as in a script, set `KEYRING_PASSPHRASE` to the passphrase and put the unlock in front of the command. It is an ordinary environment variable: set it in the shell or pass it to the job, and do not write it into the script. The first time, run `stlabs login --device` this way. Then run any other command the same way:"},"10932":{"id":"/docs/command-line-209","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"`stlabs` has these groups of commands:"},"10933":{"id":"/docs/command-line-210","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| Group     | What it covers                              |\n| --------- | ------------------------------------------- |\n| `tickets` | Create, find, update and comment on tickets |","table":"table-17"},"10934":{"id":"/docs/command-line-211","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| Group       | What it covers                             |\n| ----------- | ------------------------------------------ |\n| `approvals` | Review and answer approvals waiting on you |","table":"table-17"},"10935":{"id":"/docs/command-line-212","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| Group    | What it covers                                     |\n| -------- | -------------------------------------------------- |\n| `queues` | See and manage the queues that tickets are sent to |","table":"table-17"},"10936":{"id":"/docs/command-line-213","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| Group    | What it covers                          |\n| -------- | --------------------------------------- |\n| `people` | Check who is available to take a ticket |","table":"table-17"},"10937":{"id":"/docs/command-line-214","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| Group    | What it covers                                            |\n| -------- | --------------------------------------------------------- |\n| `access` | See who has access to what: roles, groups and permissions |","table":"table-17"},"10938":{"id":"/docs/command-line-215","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| Group       | What it covers                                            |\n| ----------- | --------------------------------------------------------- |\n| `analytics` | Find dashboards and save, edit or arrange retained charts |","table":"table-17"},"10939":{"id":"/docs/command-line-216","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| Group       | What it covers                                         |\n| ----------- | ------------------------------------------------------ |\n| `knowledge` | Manage knowledge documents and follow their processing |","table":"table-17"},"10940":{"id":"/docs/command-line-217","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| Group       | What it covers                                                             |\n| ----------- | -------------------------------------------------------------------------- |\n| `workflows` | See your workflows, turn them on or off, delete them and follow their runs |","table":"table-17"},"10941":{"id":"/docs/command-line-218","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"To see the commands:"},"10942":{"id":"/docs/command-line-219","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"`stlabs --help` lists the groups."},"10943":{"id":"/docs/command-line-220","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"`stlabs help commands` lists the commands of every group on one page. It works offline and when you are signed out."},"10944":{"id":"/docs/command-line-221","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"`stlabs tickets --help` lists the commands in a group."},"10945":{"id":"/docs/command-line-222","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"`stlabs tickets create --help` shows the arguments in order, the body fields and an example."},"10946":{"id":"/docs/command-line-223","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"The commands in these groups call the STLabs API. The rest are built into `stlabs`: `login`, `logout`, `status`, `whoami`, `org`, `setup`, `auth token`, `agent schema` and `help`. They manage your session, your settings and the agent skill."},"10947":{"id":"/docs/command-line-224","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"The API reference lists every operation with its parameters, fields and error codes, and shows the matching `stlabs` command. The Versions page explains how `stlabs` and the API are versioned."},"10948":{"id":"/docs/crash-reports","page_id":"/docs/crash-reports","type":"page","content":"Crash reports","breadcrumbs":["Docs"],"tags":[],"url":"/docs/crash-reports"},"10949":{"id":"/docs/crash-reports-0","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports","content":"What stlabs saves and sends when a command stops unexpectedly, and how to turn it off."},"10950":{"id":"/docs/crash-reports-1","page_id":"/docs/crash-reports","type":"heading","tags":[],"url":"/docs/crash-reports#what-a-report-contains","content":"What a report contains"},"10951":{"id":"/docs/crash-reports-2","page_id":"/docs/crash-reports","type":"heading","tags":[],"url":"/docs/crash-reports#what-a-report-never-contains","content":"What a report never contains"},"10952":{"id":"/docs/crash-reports-3","page_id":"/docs/crash-reports","type":"heading","tags":[],"url":"/docs/crash-reports#when-a-report-is-sent","content":"When a report is sent"},"10953":{"id":"/docs/crash-reports-4","page_id":"/docs/crash-reports","type":"heading","tags":[],"url":"/docs/crash-reports#turn-reports-off","content":"Turn reports off"},"10954":{"id":"/docs/crash-reports-5","page_id":"/docs/crash-reports","type":"heading","tags":[],"url":"/docs/crash-reports#check-that-reporting-works","content":"Check that reporting works"},"10955":{"id":"/docs/crash-reports-6","page_id":"/docs/crash-reports","type":"heading","tags":[],"url":"/docs/crash-reports#where-reports-are-kept","content":"Where reports are kept"},"10956":{"id":"/docs/crash-reports-7","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports","content":"If a `stlabs` command stops unexpectedly, it prints a short message instead of a stack trace. It\nsaves a report on your computer and sends the same report to STLabs. To stop sending reports, set\n`STLABS_TELEMETRY=0` or `DO_NOT_TRACK=1`."},"10957":{"id":"/docs/crash-reports-8","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#what-a-report-contains","content":"| Part            | What it holds                                                                                                                                                                                                                       |\n| --------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Installation id | A random id made once for this installation. It is not your name, but it links the reports from this computer to each other, even across different sign-ins. It changes if you delete the `stlabs` folder in your config directory. |","table":"table-0"},"10958":{"id":"/docs/crash-reports-9","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#what-a-report-contains","content":"| Part      | What it holds                |\n| --------- | ---------------------------- |\n| Report id | A random id for this report. |","table":"table-0"},"10959":{"id":"/docs/crash-reports-10","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#what-a-report-contains","content":"| Part                | What it holds                                                                                                                           |\n| ------------------- | --------------------------------------------------------------------------------------------------------------------------------------- |\n| Versions and system | The `stlabs` version, the API version it was built for, your operating system, your chip type and the Python version it was built with. |","table":"table-0"},"10960":{"id":"/docs/crash-reports-11","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#what-a-report-contains","content":"| Part    | What it holds                                                                                                                                         |\n| ------- | ----------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Command | The command you ran and the names of the options you gave it, such as `tickets update --title`. Only names that `stlabs` itself defines are included. |","table":"table-0"},"10961":{"id":"/docs/crash-reports-12","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#what-a-report-contains","content":"| Part  | What it holds                                                                                           |\n| ----- | ------------------------------------------------------------------------------------------------------- |\n| Error | The kind of error, and the places in the `stlabs` program where it happened, as names and line numbers. |","table":"table-0"},"10962":{"id":"/docs/crash-reports-13","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#what-a-report-contains","content":"| Part        | What it holds                                                                                                                                                                 |\n| ----------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Engine exit | Only when the crash was in the HTTP engine that `stlabs` runs: the signal that ended it or its exit code, and whether it ended in a panic. The text of the panic is not sent. |","table":"table-0"},"10963":{"id":"/docs/crash-reports-14","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#what-a-report-contains","content":"| Part            | What it holds                                                                                             |\n| --------------- | --------------------------------------------------------------------------------------------------------- |\n| Refused request | Only when the API refused a request just before the crash: the request id, the status and the error code. |","table":"table-0"},"10964":{"id":"/docs/crash-reports-15","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#what-a-report-contains","content":"| Part | What it holds            |\n| ---- | ------------------------ |\n| Time | When the crash happened. |","table":"table-0"},"10965":{"id":"/docs/crash-reports-16","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#what-a-report-contains","content":"The report is sent while you are signed in, so STLabs also sees which organization and which\nperson it came from."},"10966":{"id":"/docs/crash-reports-17","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#what-a-report-never-contains","content":"The values of the arguments and options you typed, such as ticket text and ids."},"10967":{"id":"/docs/crash-reports-18","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#what-a-report-never-contains","content":"Anything the API sent back, other than the request id, status and error code."},"10968":{"id":"/docs/crash-reports-19","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#what-a-report-never-contains","content":"Your token, headers, environment variables or file paths."},"10969":{"id":"/docs/crash-reports-20","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#what-a-report-never-contains","content":"The text of the error message."},"10970":{"id":"/docs/crash-reports-21","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#when-a-report-is-sent","content":"`stlabs` sends nothing until it has shown you a one-time notice about this page in a terminal. A\nscript or CI machine where nobody has run `stlabs` in a terminal has never shown it."},"10971":{"id":"/docs/crash-reports-22","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#when-a-report-is-sent","content":"**Before the notice.** A crash report is saved, and the message says: \"Saved: stlabs sends crash\nreports after showing its notice once in a terminal.\""},"10972":{"id":"/docs/crash-reports-23","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#when-a-report-is-sent","content":"**With the notice.** `stlabs` says how many saved reports it is about to send, when, and how to\nturn reports off. If you are not signed in or have no organization set, the reports go after you\nsign in, set an organization, or both. Otherwise they go after the command, if it works: \"stlabs\nsaved 1 crash report from earlier and will send it after this command, if it works.\""},"10973":{"id":"/docs/crash-reports-24","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#when-a-report-is-sent","content":"**After the notice.** Reports are sent unless you turn them off."},"10974":{"id":"/docs/crash-reports-25","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#when-a-report-is-sent","content":"A build that is not a release, such as one built from source, never sends reports."},"10975":{"id":"/docs/crash-reports-26","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#turn-reports-off","content":"Set `STLABS_TELEMETRY=0` or `DO_NOT_TRACK=1`. This turns off crash reports and the daily update\ncheck. Reports are still saved, but they stay on your computer and are never sent. API calls you\nmake are logged by the service as usual."},"10976":{"id":"/docs/crash-reports-27","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#turn-reports-off","content":"| Setting                                  | What happens to crash reports          |\n| ---------------------------------------- | -------------------------------------- |\n| `STLABS_TELEMETRY=0` or `DO_NOT_TRACK=1` | Saved on your computer and never sent. |","table":"table-1"},"10977":{"id":"/docs/crash-reports-28","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#turn-reports-off","content":"| Setting                  | What happens to crash reports                                                |\n| ------------------------ | ---------------------------------------------------------------------------- |\n| `STLABS_TELEMETRY=print` | Printed after the message and never sent. Use it to see what a report holds. |","table":"table-1"},"10978":{"id":"/docs/crash-reports-29","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#turn-reports-off","content":"| Setting               | What happens to crash reports                                                                                                                                         |\n| --------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `STLABS_NO_NOTICES=1` | Not stopped. This setting hides notices only. On a computer that has never shown the one-time notice, it keeps the notice from being shown, so nothing is sent there. |","table":"table-1"},"10979":{"id":"/docs/crash-reports-30","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#check-that-reporting-works","content":"Run `STLABS_CRASH_TEST=1 stlabs --version`. `stlabs` stops on purpose with an error named\n`CrashTest`. The message, the saved file and the report follow the same rules as a real crash. Use\nit to see a report made and sent without waiting for a real problem. It is sent only after the\none-time notice has been shown, and only while you are signed in with an organization set."},"10980":{"id":"/docs/crash-reports-31","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#where-reports-are-kept","content":"Reports are kept in the `crash-reports` folder next to your `stlabs` config file, which is in\n`~/.config/stlabs` by default. The crash message names the file to attach if you write to\nsupport@stlabs.com. You can delete the folder at any time."},"10981":{"id":"/docs/crash-reports-32","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#where-reports-are-kept","content":"| Report                                                       | What happens to it                                                                                                     |\n| ------------------------------------------------------------ | ---------------------------------------------------------------------------------------------------------------------- |\n| Made while you were not signed in or had no organization set | Waits in the folder and is sent after a later command that works. To set an organization, run `stlabs org set <slug>`. |","table":"table-2"},"10982":{"id":"/docs/crash-reports-33","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#where-reports-are-kept","content":"| Report                                                          | What happens to it                                                       |\n| --------------------------------------------------------------- | ------------------------------------------------------------------------ |\n| Not delivered because of a network problem or a temporary error | Waits in the folder and is tried again after a later command that works. |","table":"table-2"},"10983":{"id":"/docs/crash-reports-34","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#where-reports-are-kept","content":"| Report                                                            | What happens to it          |\n| ----------------------------------------------------------------- | --------------------------- |\n| Waiting for more than 7 days, or made for a different API address | Deleted without being sent. |","table":"table-2"},"10984":{"id":"/docs/crash-reports-35","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#where-reports-are-kept","content":"| Report            | What happens to it           |\n| ----------------- | ---------------------------- |\n| Refused by STLabs | Stays only on your computer. |","table":"table-2"},"10985":{"id":"/docs/crash-reports-36","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#where-reports-are-kept","content":"| Report                                                   | What happens to it                                                             |\n| -------------------------------------------------------- | ------------------------------------------------------------------------------ |\n| The same kind of crash as a report sent in the last hour | Stays only on your computer. At most one report of each kind is sent per hour. |","table":"table-2"},"10986":{"id":"/docs/crash-reports-37","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#where-reports-are-kept","content":"| Report                      | What happens to it           |\n| --------------------------- | ---------------------------- |\n| Saved while reports are off | Stays only on your computer. |","table":"table-2"},"10987":{"id":"/docs/crash-reports-38","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#where-reports-are-kept","content":"The folder keeps the 20 newest files. A report sent within the last hour is also kept, whatever\nits age, because it is what stops the same crash being sent twice."},"10988":{"id":"/docs/install","page_id":"/docs/install","type":"page","content":"Install","breadcrumbs":["Docs"],"tags":[],"url":"/docs/install"},"10989":{"id":"/docs/install-0","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install","content":"Install or update stlabs on macOS or Linux."},"10990":{"id":"/docs/install-1","page_id":"/docs/install","type":"heading","tags":[],"url":"/docs/install#about","content":"About"},"10991":{"id":"/docs/install-2","page_id":"/docs/install","type":"heading","tags":[],"url":"/docs/install#install","content":"Install"},"10992":{"id":"/docs/install-3","page_id":"/docs/install","type":"heading","tags":[],"url":"/docs/install#usage","content":"Usage"},"10993":{"id":"/docs/install-4","page_id":"/docs/install","type":"heading","tags":[],"url":"/docs/install#update-and-uninstall","content":"Update and uninstall"},"10994":{"id":"/docs/install-5","page_id":"/docs/install","type":"heading","tags":[],"url":"/docs/install#read-on","content":"Read on"},"10995":{"id":"/docs/install-6","page_id":"/docs/install","type":"heading","tags":[],"url":"/docs/install#questions-and-support","content":"Questions and support"},"10996":{"id":"/docs/install-7","page_id":"/docs/install","type":"heading","tags":[],"url":"/docs/install#license","content":"License"},"10997":{"id":"/docs/install-8","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#about","content":"stlabs is the command line for Standard Template Labs (STLabs)."},"10998":{"id":"/docs/install-9","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#about","content":"Read, search, create and update tickets without leaving the shell."},"10999":{"id":"/docs/install-10","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#about","content":"Script it: JSON out, exit codes, safe retries with an idempotency key."},"11000":{"id":"/docs/install-11","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#about","content":"One folder per platform, no runtime to install."},"11001":{"id":"/docs/install-12","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#about","content":"Built from the same API description as the service, so it never drifts."},"11002":{"id":"/docs/install-13","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#install","content":"stlabs is available for macOS (Apple silicon) and Linux (x86_64)."},"11003":{"id":"/docs/install-14","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#install","content":"The script fetches this platform's build, checks it against the release's checksums, and by default unpacks it under `~/.local/share/stlabs` and links `~/.local/bin/stlabs`. It edits no shell files; if `~/.local/bin` is not on your PATH, it prints the line to add. To install a release candidate, name its version: end the command with `sh -s -- --version <version>`."},"11004":{"id":"/docs/install-15","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#install","content":"Check the install with `stlabs --version`."},"11005":{"id":"/docs/install-16","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#usage","content":"**List and read.** On a terminal a list is a table; everything else is JSON."},"11006":{"id":"/docs/install-17","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#usage","content":"Example output of tickets get --output json"},"11007":{"id":"/docs/install-18","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#usage","content":"**Create and update.** Fields go in one argument of `name: value` pairs."},"11008":{"id":"/docs/install-19","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#usage","content":"**Script it.** Piped or redirected output is JSON, one record per command, so pipe it into jq or capture it. A command that fails exits with a code that says why."},"11009":{"id":"/docs/install-20","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#update-and-uninstall","content":"Update: run the install line again. It installs the newest release and keeps the one before it. If you installed the agent skill, run `stlabs setup` again to update it."},"11010":{"id":"/docs/install-21","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#update-and-uninstall","content":"Uninstall: run `stlabs logout`, then remove `~/.local/share/stlabs`, `~/.local/bin/stlabs` (the default locations) and `~/.config/stlabs`. If you installed the agent skill, also remove its `stlabs-cli` folder wherever it is installed, such as in `~/.claude/skills` or `~/.agents/skills`."},"11011":{"id":"/docs/install-22","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#read-on","content":"<Card icon=\"Terminal\" title=\"Command line guide\" href=\"/docs/command-line/\">Sign in, do everyday tasks, script with output and exit codes, and fix common problems.</Card>"},"11012":{"id":"/docs/install-23","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#read-on","content":"<Card icon=\"BookOpen\" title=\"API reference\" href=\"/docs/api/2026-09-14/\">Each operation with its parameters, request and response fields and error codes.</Card>"},"11013":{"id":"/docs/install-24","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#read-on","content":"<Card icon=\"Package\" title=\"Releases\" href=\"https://github.com/Standard-Template-Labs/cli/releases\" external>every build, with checksums and notices.</Card>"},"11014":{"id":"/docs/install-25","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#questions-and-support","content":"Questions, access requests and problems: support@stlabs.com."},"11015":{"id":"/docs/install-26","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#questions-and-support","content":"Security issues: security@stlabs.com, see https://stlabs.com/security."},"11016":{"id":"/docs/install-27","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#license","content":"The stlabs binary is Standard Template Labs (STLabs) software, under the terms at https://stlabs.com/terms. The open source software bundled in it is listed, with its licenses, in THIRD_PARTY_NOTICES.md on each release."},"11017":{"id":"/docs/install-28","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#license","content":"The notices for the current release: THIRD_PARTY_NOTICES.md on its page."},"11018":{"id":"/docs/notices","page_id":"/docs/notices","type":"page","content":"Update notices","breadcrumbs":["Docs"],"tags":[],"url":"/docs/notices"},"11019":{"id":"/docs/notices-0","page_id":"/docs/notices","tags":[],"type":"text","url":"/docs/notices","content":"The once a day line about a newer version or a known problem, and how to turn it off."},"11020":{"id":"/docs/notices-1","page_id":"/docs/notices","type":"heading","tags":[],"url":"/docs/notices#how-the-check-works","content":"How the check works"},"11021":{"id":"/docs/notices-2","page_id":"/docs/notices","type":"heading","tags":[],"url":"/docs/notices#what-it-sends","content":"What it sends"},"11022":{"id":"/docs/notices-3","page_id":"/docs/notices","type":"heading","tags":[],"url":"/docs/notices#turn-it-off","content":"Turn it off"},"11023":{"id":"/docs/notices-4","page_id":"/docs/notices","tags":[],"type":"text","url":"/docs/notices","content":"Once a day, after a command, `stlabs` may print one line about the version you are running. The\nline goes to stderr, so it never mixes with the output a script reads. It is not shown when the\noutput is not a terminal or when you use `--output`."},"11024":{"id":"/docs/notices-5","page_id":"/docs/notices","tags":[],"type":"text","url":"/docs/notices","content":"The line says one of these, in this order of priority:"},"11025":{"id":"/docs/notices-6","page_id":"/docs/notices","tags":[],"type":"text","url":"/docs/notices","content":"The version you are running has a problem we know about, and what to do."},"11026":{"id":"/docs/notices-7","page_id":"/docs/notices","tags":[],"type":"text","url":"/docs/notices","content":"The version you are running is no longer supported."},"11027":{"id":"/docs/notices-8","page_id":"/docs/notices","tags":[],"type":"text","url":"/docs/notices","content":"A newer version is out."},"11028":{"id":"/docs/notices-9","page_id":"/docs/notices","tags":[],"type":"text","url":"/docs/notices#how-the-check-works","content":"`stlabs` asks STLabs for its current notice only when you are signed in and have an organization\nset. Otherwise nothing is asked and nothing is shown."},"11029":{"id":"/docs/notices-10","page_id":"/docs/notices","tags":[],"type":"text","url":"/docs/notices#how-the-check-works","content":"It asks at most once every 24 hours, after the command has finished."},"11030":{"id":"/docs/notices-11","page_id":"/docs/notices","tags":[],"type":"text","url":"/docs/notices#how-the-check-works","content":"It gives up after 2 seconds. If the answer cannot be read, nothing fails."},"11031":{"id":"/docs/notices-12","page_id":"/docs/notices","tags":[],"type":"text","url":"/docs/notices#how-the-check-works","content":"STLabs can change the notice at any time. For example, it can warn about a problem in a version\nwithout waiting for a new release."},"11032":{"id":"/docs/notices-13","page_id":"/docs/notices","tags":[],"type":"text","url":"/docs/notices#how-the-check-works","content":"The last answer keeps applying for up to 7 days. After that, nothing is shown until a new answer\ncan be read."},"11033":{"id":"/docs/notices-14","page_id":"/docs/notices","tags":[],"type":"text","url":"/docs/notices#how-the-check-works","content":"A build that is not a release, such as one built from source, never checks."},"11034":{"id":"/docs/notices-15","page_id":"/docs/notices","tags":[],"type":"text","url":"/docs/notices#what-it-sends","content":"The same sign-in details every `stlabs` call sends: your token and your organization. It adds no\nid and nothing about your tickets."},"11035":{"id":"/docs/notices-16","page_id":"/docs/notices","tags":[],"type":"text","url":"/docs/notices#turn-it-off","content":"| Setting               | What it turns off                    |\n| --------------------- | ------------------------------------ |\n| `STLABS_NO_NOTICES=1` | Every one-line notice from `stlabs`. |","table":"table-0"},"11036":{"id":"/docs/notices-17","page_id":"/docs/notices","tags":[],"type":"text","url":"/docs/notices#turn-it-off","content":"| Setting                                  | What it turns off                         |\n| ---------------------------------------- | ----------------------------------------- |\n| `STLABS_TELEMETRY=0` or `DO_NOT_TRACK=1` | The daily update check and crash reports. |","table":"table-0"},"11037":{"id":"/docs/notices-18","page_id":"/docs/notices","tags":[],"type":"text","url":"/docs/notices#turn-it-off","content":"API calls you make are logged by the service as usual."},"11038":{"id":"/docs/versions","page_id":"/docs/versions","type":"page","content":"Versions","breadcrumbs":["Docs"],"tags":[],"url":"/docs/versions"},"11039":{"id":"/docs/versions-0","page_id":"/docs/versions","tags":[],"type":"text","url":"/docs/versions","content":"How the command line and the API are versioned."},"11040":{"id":"/docs/versions-1","page_id":"/docs/versions","tags":[],"type":"text","url":"/docs/versions","content":"The command line is versioned by semantic versioning; the API is versioned\nby date. They move for different reasons and never force each other."},"11041":{"id":"/docs/versions-2","page_id":"/docs/versions","tags":[],"type":"text","url":"/docs/versions","content":"Every build is made from one API version and sends it on every call. A build keeps working on\nits API version until that version is retired. New commands come with a new build."},"11042":{"id":"/docs/versions-3","page_id":"/docs/versions","tags":[],"type":"text","url":"/docs/versions","content":"A breaking change to the commands, flags, environment variables, config path or exit codes raises\nthe minor version before 1.0 and the major version from 1.0. New commands raise the minor version.\nA fix raises the patch version."},"11043":{"id":"/docs/versions-4","page_id":"/docs/versions","tags":[],"type":"text","url":"/docs/versions","content":"`stlabs --version` prints the build's version and its API version."},"11044":{"id":"/docs/versions-5","page_id":"/docs/versions","tags":[],"type":"text","url":"/docs/versions","content":"Every change is in the changelog, and we tell you before anything you use stops working. Problems: email support@stlabs.com with the request id."}},"count":11044},"sorting":{"language":"english","sortableProperties":["content","page_id","type","url"],"sortablePropertiesWithTypes":{"content":"string","page_id":"string","type":"string","url":"string"},"sorts":{"content":{"docs":{"1":8790,"2":8801,"3":9372,"4":9926,"5":8505,"6":10969,"7":7297,"8":7263,"9":7397,"10":7515,"11":6295,"12":4854,"13":9330,"14":5436,"15":5680,"16":7096,"17":5302,"18":6177,"19":7686,"20":2337,"21":3889,"22":805,"23":2111,"24":1659,"25":767,"26":3255,"27":3029,"28":2789,"29":3481,"30":1885,"31":2563,"32":9242,"33":9681,"34":9373,"35":9927,"36":8506,"37":9706,"38":7543,"39":7539,"40":6479,"41":6423,"42":6649,"43":7913,"44":7172,"45":6527,"46":6827,"47":7914,"48":7173,"49":6528,"50":6828,"51":7687,"52":423,"53":2338,"54":3017,"55":1545,"56":1315,"57":1291,"58":1643,"59":1653,"60":1407,"61":781,"62":1411,"63":1163,"64":1035,"65":529,"66":3890,"67":3711,"68":806,"69":2112,"70":1660,"71":3256,"72":3030,"73":2790,"74":3482,"75":1886,"76":2564,"77":10385,"78":8413,"79":9374,"80":9928,"81":8507,"82":10390,"83":7544,"84":7540,"85":6480,"86":6424,"87":6650,"88":7915,"89":7174,"90":6529,"91":6829,"92":7916,"93":7175,"94":6530,"95":6830,"96":7688,"97":424,"98":2339,"99":3018,"100":1546,"101":1316,"102":1292,"103":1654,"104":782,"105":1412,"106":1164,"107":1036,"108":530,"109":3891,"110":3712,"111":807,"112":2113,"