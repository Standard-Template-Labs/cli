/command-line-26","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| command                    |                          |\n| -------------------------- | ------------------------ |\n| `stlabs queues setdefault` | Make a queue the default |","table":"table-0"},"1280":{"id":"/docs/command-line-27","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| command                |                |\n| ---------------------- | -------------- |\n| `stlabs queues update` | Change a queue |","table":"table-0"},"1281":{"id":"/docs/command-line-28","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| command                      |                             |\n| ---------------------------- | --------------------------- |\n| `stlabs tickets bulk update` | Change many tickets at once |","table":"table-0"},"1282":{"id":"/docs/command-line-29","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| command                          |                           |\n| -------------------------------- | ------------------------- |\n| `stlabs tickets comments create` | Add a comment to a ticket |","table":"table-0"},"1283":{"id":"/docs/command-line-30","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| command                          |                            |\n| -------------------------------- | -------------------------- |\n| `stlabs tickets comments delete` | Delete a comment you wrote |","table":"table-0"},"1284":{"id":"/docs/command-line-31","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| command                        |                              |\n| ------------------------------ | ---------------------------- |\n| `stlabs tickets comments list` | Read a ticket's conversation |","table":"table-0"},"1285":{"id":"/docs/command-line-32","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| command                          |                            |\n| -------------------------------- | -------------------------- |\n| `stlabs tickets comments update` | Change a comment you wrote |","table":"table-0"},"1286":{"id":"/docs/command-line-33","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| command                     |                                           |\n| --------------------------- | ----------------------------------------- |\n| `stlabs tickets counts get` | Count tickets by state, queue or priority |","table":"table-0"},"1287":{"id":"/docs/command-line-34","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| command                 |               |\n| ----------------------- | ------------- |\n| `stlabs tickets create` | File a ticket |","table":"table-0"},"1288":{"id":"/docs/command-line-35","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| command              |                |\n| -------------------- | -------------- |\n| `stlabs tickets get` | Get one ticket |","table":"table-0"},"1289":{"id":"/docs/command-line-36","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| command               |                         |\n| --------------------- | ----------------------- |\n| `stlabs tickets list` | List and filter tickets |","table":"table-0"},"1290":{"id":"/docs/command-line-37","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| command                |                     |\n| ---------------------- | ------------------- |\n| `stlabs tickets nudge` | Remind the assignee |","table":"table-0"},"1291":{"id":"/docs/command-line-38","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| command                          |                                     |\n| -------------------------------- | ----------------------------------- |\n| `stlabs tickets priorities list` | Read your organization's priorities |","table":"table-0"},"1292":{"id":"/docs/command-line-39","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| command                      |                                 |\n| ---------------------------- | ------------------------------- |\n| `stlabs tickets queues list` | Read your organization's queues |","table":"table-0"},"1293":{"id":"/docs/command-line-40","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| command                               |                  |\n| ------------------------------------- | ---------------- |\n| `stlabs tickets relationships create` | Link two tickets |","table":"table-0"},"1294":{"id":"/docs/command-line-41","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| command                             |                                |\n| ----------------------------------- | ------------------------------ |\n| `stlabs tickets relationships list` | Read a ticket's linked tickets |","table":"table-0"},"1295":{"id":"/docs/command-line-42","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| command                                   |                                        |\n| ----------------------------------------- | -------------------------------------- |\n| `stlabs tickets relationships types list` | Read the kinds of link between tickets |","table":"table-0"},"1296":{"id":"/docs/command-line-43","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| command                       |                            |\n| ----------------------------- | -------------------------- |\n| `stlabs tickets similar list` | Find tickets like this one |","table":"table-0"},"1297":{"id":"/docs/command-line-44","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| command                      |                                 |\n| ---------------------------- | ------------------------------- |\n| `stlabs tickets states list` | Read your organization's states |","table":"table-0"},"1298":{"id":"/docs/command-line-45","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| command                     |                                |\n| --------------------------- | ------------------------------ |\n| `stlabs tickets transition` | Move a ticket through its life |","table":"table-0"},"1299":{"id":"/docs/command-line-46","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| command                 |                          |\n| ----------------------- | ------------------------ |\n| `stlabs tickets update` | Change a ticket's fields |","table":"table-0"},"1300":{"id":"/docs/command-line-47","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"`stlabs --help`, `stlabs tickets --help` and `stlabs tickets create --help` show the commands, the\narguments in order, the body fields and an example. Any other word is refused with\n`stlabs: unknown command`."},"1301":{"id":"/docs/command-line-48","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"A file, read, edit, comment, resolve loop. `dana@northwind.example` and the `northwind`\norganization are sample data, not a real organization. Use a person in yours:"},"1302":{"id":"/docs/command-line-49","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"The first and last commands file the same ticket with the same key. The second returns the first\nticket instead of filing another."},"1303":{"id":"/docs/command-line-50","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#three-rules","content":"**Every command that changes something is sent with an idempotency key.** stlabs generates a\nnew one each run, so running a command twice makes two changes. To make a retry safe, choose the\nkey yourself with `--idempotency-key <key>`. The same key with the same body returns the original\nresponse instead of a second ticket. It has the same `id` and the same status, and the header\n`Idempotent-Replayed` is `\"true\"`. The same key with a different body is refused with\n`IDEMPOTENCY_KEY_MISMATCH`. When a change fails in a way\nthat is safe to retry, stlabs prints the command to retry it with, key included, unless the\ncommand ran with `--query` or `--output` (the hint names the key alone then)."},"1304":{"id":"/docs/command-line-51","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#three-rules","content":"**A body is one argument of `field: value` pairs, separated by commas.** Put the whole body in\nsingle quotes. Put a value in double quotes if it contains a comma, looks like a number, is\n`true`, `false` or `null`, or starts with `[` or `{`. Unquoted, those are sent as something other\nthan text. For example `'title: \"Filed, then edited\"'`, `'title: \"123\"'` or `'title: \"true\"'`.\nA word after the body is refused rather than added to it."},"1305":{"id":"/docs/command-line-52","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#three-rules","content":"**A failed call still prints to the same stream a successful one would, and exits non-zero.**\nstlabs prints the response the same way on success or failure. `--query` and `--output` apply\nto a problem body as they apply to a real one, so a selected field prints `null` on a 404, not\nnothing. Check the exit code, as in `ID=$(stlabs ...) || exit`, not whether output came back\nempty."},"1306":{"id":"/docs/command-line-53","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#output-and-exit-codes","content":"A command prints the response body as JSON. On a terminal, a command that lists records prints a\ntable of its main columns instead; piped or redirected output is JSON unless `--output` says\notherwise, printed on one line with no trailing newline. `--output` picks the format: `json`,\n`yaml`, `table` or `lines`.\nA command takes only the options its `--help` lists."},"1307":{"id":"/docs/command-line-54","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#shape-the-output","content":"`--query` selects part of the response with a JMESPath expression, starting from the whole\nresponse (`status`, `headers` and `body`): `--query body.id` prints the id alone, which is how\nthe examples above capture a new ticket's id into a variable."},"1308":{"id":"/docs/command-line-55","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#shape-the-output","content":"A command that reads is retried twice on a 429 or 5xx response, waiting as long as `Retry-After`\nasks. Each retry prints `warning: retry 1/2 in <wait>` on stderr. A command that changes something\nis never retried automatically. A 5xx or a network failure leaves the server unsure whether the\nchange landed. stlabs then names the read that shows it (for a comment, `stlabs tickets comments\nlist <ticket>`) and tells you to check with it before running the change again. A same-key retry\nis safe only on a 429 (`RATE_LIMITED`) or `IDEMPOTENCY_IN_FLIGHT`: the first request was refused\nbefore it started, or is still running. There stlabs prints the command to retry with, key included."},"1309":{"id":"/docs/command-line-56","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#shape-the-output","content":"| exit | meaning |\n| ---- | ------- |\n| 0    | success |","table":"table-1"},"1310":{"id":"/docs/command-line-57","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#shape-the-output","content":"| exit | meaning                                                                                                                     |\n| ---- | --------------------------------------------------------------------------------------------------------------------------- |\n| 1    | not signed in, no organization set, a body that does not parse, or a network error on a host you set with `STLABS_BASE_URL` |","table":"table-1"},"1311":{"id":"/docs/command-line-58","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#shape-the-output","content":"| exit | meaning                                                                    |\n| ---- | -------------------------------------------------------------------------- |\n| 2    | a usage error: an unknown command or option, or missing or extra arguments |","table":"table-1"},"1312":{"id":"/docs/command-line-59","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#shape-the-output","content":"| exit | meaning                                           |\n| ---- | ------------------------------------------------- |\n| 3    | the API answered with a redirect (a 3xx response) |","table":"table-1"},"1313":{"id":"/docs/command-line-60","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#shape-the-output","content":"| exit | meaning                                      |\n| ---- | -------------------------------------------- |\n| 4    | the API refused the request (a 4xx response) |","table":"table-1"},"1314":{"id":"/docs/command-line-61","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#shape-the-output","content":"| exit | meaning                         |\n| ---- | ------------------------------- |\n| 5    | the API failed (a 5xx response) |","table":"table-1"},"1315":{"id":"/docs/command-line-62","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#shape-the-output","content":"| exit | meaning                                  |\n| ---- | ---------------------------------------- |\n| 10   | access to the STLabs API is not open yet |","table":"table-1"},"1316":{"id":"/docs/command-line-63","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#shape-the-output","content":"A refused token prints `stlabs: the API refused the token (expired or invalid)` on stderr, before\nthe response itself. Run `stlabs login` again to sign in with a new token. A problem body carries\na stable `code` to branch on, a `detail` for people, and `retryable`."},"1317":{"id":"/docs/command-line-64","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#versions","content":"Versions are handled for you: every command pins the API version it was built for (`STLabs-Version: 2026-09-14`) and names your organization; every change carries an idempotency key."},"1318":{"id":"/docs/install","page_id":"/docs/install","type":"page","content":"Install","breadcrumbs":["Docs"],"tags":[],"url":"/docs/install"},"1319":{"id":"/docs/install-0","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install","content":"One line, nothing else to install."},"1320":{"id":"/docs/install-1","page_id":"/docs/install","type":"heading","tags":[],"url":"/docs/install#about","content":"About"},"1321":{"id":"/docs/install-2","page_id":"/docs/install","type":"heading","tags":[],"url":"/docs/install#install","content":"Install"},"1322":{"id":"/docs/install-3","page_id":"/docs/install","type":"heading","tags":[],"url":"/docs/install#usage","content":"Usage"},"1323":{"id":"/docs/install-4","page_id":"/docs/install","type":"heading","tags":[],"url":"/docs/install#update-and-uninstall","content":"Update and uninstall"},"1324":{"id":"/docs/install-5","page_id":"/docs/install","type":"heading","tags":[],"url":"/docs/install#read-on","content":"Read on"},"1325":{"id":"/docs/install-6","page_id":"/docs/install","type":"heading","tags":[],"url":"/docs/install#questions-and-support","content":"Questions and support"},"1326":{"id":"/docs/install-7","page_id":"/docs/install","type":"heading","tags":[],"url":"/docs/install#license","content":"License"},"1327":{"id":"/docs/install-8","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#about","content":"stlabs is the command line for Standard Template Labs (STLabs)."},"1328":{"id":"/docs/install-9","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#about","content":"Read, search, create and update tickets without leaving the shell."},"1329":{"id":"/docs/install-10","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#about","content":"Script it: JSON out, exit codes, safe retries with an idempotency key."},"1330":{"id":"/docs/install-11","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#about","content":"One folder per platform, no runtime to install."},"1331":{"id":"/docs/install-12","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#about","content":"Built from the same API description as the service, so it never drifts."},"1332":{"id":"/docs/install-13","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#install","content":"stlabs is available for macOS (Apple silicon) and Linux (x86_64)."},"1333":{"id":"/docs/install-14","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#install","content":"<Callout type=\"info\" title=\"Access\">Access to the STLabs API is not open yet. This release cannot sign in or call the API. To request access, email support@stlabs.com.</Callout>"},"1334":{"id":"/docs/install-15","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#install","content":"The script fetches this platform's build, checks it against the release's checksums, and by default unpacks it under `~/.local/share/stlabs` and links `~/.local/bin/stlabs`. It edits no shell files; if `~/.local/bin` is not on your PATH, it prints the line to add."},"1335":{"id":"/docs/install-16","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#install","content":"Check the install with `stlabs --version`."},"1336":{"id":"/docs/install-17","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#install","content":"<Callout type=\"warn\" title=\"macOS\">macOS may block the first run of an unsigned app. If it does, open System Settings, Privacy & Security, and choose Open Anyway.</Callout>"},"1337":{"id":"/docs/install-18","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#usage","content":"**List and read.** On a terminal a list is a table; everything else is JSON."},"1338":{"id":"/docs/install-19","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#usage","content":"Example output of tickets get"},"1339":{"id":"/docs/install-20","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#usage","content":"**Create and update.** Fields go in one argument of `name: value` pairs."},"1340":{"id":"/docs/install-21","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#usage","content":"**Script it.** Piped or redirected output is JSON, one record per command, so pipe it into jq or capture it. A command that fails exits with a code that says why."},"1341":{"id":"/docs/install-22","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#usage","content":"While access is not open, sign-in and every API call print the access notice and exit with code 10."},"1342":{"id":"/docs/install-23","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#update-and-uninstall","content":"Update: run the install line again. It installs the newest release and keeps the one before it."},"1343":{"id":"/docs/install-24","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#update-and-uninstall","content":"Uninstall: run `stlabs logout`, then remove `~/.local/share/stlabs`, `~/.local/bin/stlabs` (the default locations) and `~/.config/stlabs`."},"1344":{"id":"/docs/install-25","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#read-on","content":"<Card icon=\"Terminal\" title=\"Command line guide\" href=\"/docs/command-line/\">Every command, the body syntax, output options, exit codes and idempotency.</Card>"},"1345":{"id":"/docs/install-26","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#read-on","content":"<Card icon=\"BookOpen\" title=\"API reference\" href=\"/docs/api/\">Each operation with its parameters, request and response fields and error codes.</Card>"},"1346":{"id":"/docs/install-27","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#read-on","content":"<Card icon=\"Package\" title=\"Releases\" href=\"https://github.com/Standard-Template-Labs/cli/releases\" external>every build, with checksums and notices.</Card>"},"1347":{"id":"/docs/install-28","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#questions-and-support","content":"Questions, access requests and problems: support@stlabs.com."},"1348":{"id":"/docs/install-29","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#questions-and-support","content":"Security issues: security@stlabs.com, see https://stlabs.com/security."},"1349":{"id":"/docs/install-30","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#license","content":"The stlabs binary is Standard Template Labs (STLabs) software, under the terms at https://stlabs.com/terms. The open source software bundled in it is listed, with its licenses, in THIRD_PARTY_NOTICES.md on each release."},"1350":{"id":"/docs/install-31","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#license","content":"The notices for the current release: THIRD_PARTY_NOTICES.md on its page."},"1351":{"id":"/docs/versions","page_id":"/docs/versions","type":"page","content":"Versions","breadcrumbs":["Docs"],"tags":[],"url":"/docs/versions"},"1352":{"id":"/docs/versions-0","page_id":"/docs/versions","tags":[],"type":"text","url":"/docs/versions","content":"How the command line and the API are versioned."},"1353":{"id":"/docs/versions-1","page_id":"/docs/versions","tags":[],"type":"text","url":"/docs/versions","content":"The command line is versioned by semantic versioning; the API is versioned\nby date. They move for different reasons and never force each other."},"1354":{"id":"/docs/versions-2","page_id":"/docs/versions","tags":[],"type":"text","url":"/docs/versions","content":"Every build is made from one API version and sends it on every call. A build keeps working on\nits API version until that version is retired. New commands come with a new build."},"1355":{"id":"/docs/versions-3","page_id":"/docs/versions","tags":[],"type":"text","url":"/docs/versions","content":"A change to the commands, flags, environment variables, config path or exit codes is a major\nversion. New commands from an additive API change are a minor version. A fix is a patch."},"1356":{"id":"/docs/versions-4","page_id":"/docs/versions","tags":[],"type":"text","url":"/docs/versions","content":"Before 1.0 nothing above is a promise: the surface can still change between releases."},"1357":{"id":"/docs/versions-5","page_id":"/docs/versions","tags":[],"type":"text","url":"/docs/versions","content":"`stlabs --version` prints the build's version and its API version."}},"count":1357},"sorting":{"language":"english","sortableProperties":["content","page_id","type","url"],"sortablePropertiesWithTypes":{"content":"string","page_id":"string","type":"string","url":"string"},"sorts":{"content":{"docs":{"1":1041,"2":1042,