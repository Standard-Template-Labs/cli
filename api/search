s-grants-add-5","page_id":"/docs/api/2026-09-14/workflows-grants-add","tags":[],"type":"text","url":"/docs/api/2026-09-14/workflows-grants-add#parameters","content":"| Name       | In   | Type   | Required | Description                                    |\n| ---------- | ---- | ------ | -------- | ---------------------------------------------- |\n| `workflow` | path | string | yes      | The workflow's id, from the list of workflows. |","table":"table-0"},"4880":{"id":"/docs/api/2026-09-14/workflows-grants-add-6","page_id":"/docs/api/2026-09-14/workflows-grants-add","tags":[],"type":"text","url":"/docs/api/2026-09-14/workflows-grants-add#parameters","content":"| Name           | In   | Type   | Required | Description                                                               |\n| -------------- | ---- | ------ | -------- | ------------------------------------------------------------------------- |\n| `grantee_type` | path | string | yes      | `person` or `group`. Everyone in your organization is the group Everyone. |","table":"table-0"},"4881":{"id":"/docs/api/2026-09-14/workflows-grants-add-7","page_id":"/docs/api/2026-09-14/workflows-grants-add","tags":[],"type":"text","url":"/docs/api/2026-09-14/workflows-grants-add#parameters","content":"| Name      | In   | Type   | Required | Description                                                 |\n| --------- | ---- | ------ | -------- | ----------------------------------------------------------- |\n| `grantee` | path | string | yes      | The person's id, or the group's id from the list of groups. |","table":"table-0"},"4882":{"id":"/docs/api/2026-09-14/workflows-grants-add-8","page_id":"/docs/api/2026-09-14/workflows-grants-add","tags":[],"type":"text","url":"/docs/api/2026-09-14/workflows-grants-add#parameters","content":"| Name         | In   | Type   | Required | Description                                                                                                                                          