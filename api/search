and no longer answers. Use its replacement if the response names one. |","table":"table-3"},"7862":{"id":"/docs/api/latest/workflows-versions-get-21","page_id":"/docs/api/latest/workflows-versions-get","tags":[],"type":"text","url":"/docs/api/latest/workflows-versions-get#errors","content":"| Code       | HTTP status | Meaning                                                                                      |\n| ---------- | ----------- | -------------------------------------------------------------------------------------------- |\n| `INTERNAL` | 500         | Something went wrong on our side. Try again, and quote the request id if it keeps happening. |","table":"table-3"},"7863":{"id":"/docs/api/latest/workflows-versions-get-22","page_id":"/docs/api/latest/workflows-versions-get","tags":[],"type":"text","url":"/docs/api/latest/workflows-versions-get#errors","content":"| Code        | HTTP status | Meaning                                                                          |\n| ----------- | ----------- | -------------------------------------------------------------------------------- |\n| `NOT_FOUND` | 404         | Nothing with this identifier exists, or you cannot see it. Check the identifier. |","table":"table-3"},"7864":{"id":"/docs/api/latest/workflows-versions-get-23","page_id":"/docs/api/latest/workflows-versions-get","tags":[],"type":"text","url":"/docs/api/latest/workflows-versions-get#errors","content":"| Code                       | HTTP status | Meaning                                                                             |\n| -------------------------- | ----------- | ----------------------------------------------------------------------------------- |\n| `ORGANIZATION_NOT_ENABLED` | 403         | Your organization is not set up for the API. Email support@stlabs.com to set it up. |","table":"table-3"},"7865":{"id":"/docs/api/latest/workflows-versions-get-24","page_id":"/docs/api/latest/workflows-versions-get","tags":[],"type":"text","url":"/docs/api/latest/workflows-versions-get#errors","content":"| Code                | HTTP status | Meaning                                            |\n| ------------------- | ----------- | -------------------------------------------------- |\n| `PAYLOAD_TOO_LARGE` | 413         | The request body is too large. Send at most 1 MiB. |","table":"table-3"},"7866":{"id":"/docs/api/latest/workflows-versions-get-25","page_id":"/docs/api/latest/workflows-versions-get","tags":[],"type":"text","url":"/docs/api/latest/workflows-versions-get#errors","content":"| Code                | HTTP status | Meaning                                                                                     |\n| ------------------- | ----------- | ------------------------------------------------------------------------------------------- |\n| `PERMISSION_DENIED` | 403         | Your account cannot take this action. Ask an administrator in your organization for access. |","table":"table-3"},"7867":{"id":"/docs/api/latest/workflows-versions-get-26","page_id":"/docs/api/latest/workflows-versions-get","tags":[],"type":"text","url":"/docs/api/latest/workflows-versions-get#errors","content":"| Code           | HTTP status | Meaning                                                                                      |\n| -------------- | ----------- | -------------------------------------------------------------------------------------------- |\n| `RATE_LIMITED` | 429         | You are sending requests too quickly. Wait as long as the response says, then send it again. |","table":"table-3"},"7868":{"id":"/docs/api/latest/workflows-versions-get-27","page_id":"/docs/api/latest/workflows-versions-get","tags":[],"type":"text","url":"/docs/api/latest/workflows-versions-get#errors","content":"| Code            | HTTP status | Meaning                                                                                |\n| --------------- | ----------- | -------------------------------------------------------------------------------------- |\n| `SCOPE_MISSING` | 403         | Your connection was not granted access to this kind of action. Reconnect and grant it. |","table":"table-3"},"7869":{"id":"/docs/api/latest/workflows-versions-get-28","page_id":"/docs/api/latest/workflows-versions-get","tags":[],"type":"text","url":"/docs/api/latest/workflows-versions-get#errors","content":"| Code              | HTTP status | Meaning                                                          |\n| ----------------- | ----------- | ---------------------------------------------------------------- |\n| `UNAUTHENTICATED` | 401         | You are not signed in, or your token has expired. Sign in again. |","table":"table-3"},"7870":{"id":"/docs/api/latest/workflows-versions-get-29","page_id":"/docs/api/latest/workflows-versions-get","tags":[],"type":"text","url":"/docs/api/latest/workflows-versions-get#errors","content":"| Code          | HTTP status | Meaning                                                  |\n| ------------- | ----------- | -------------------------------------------------------- |\n| `UNAVAILABLE` | 503         | The service is temporarily unavailable. Try again later. |","table":"table-3"},"7871":{"id":"/docs/api/latest/workflows-versions-get-30","page_id":"/docs/api/latest/workflows-versions-get","tags":[],"type":"text","url":"/docs/api/latest/workflows-versions-get#errors","content":"| Code                | HTTP status | Meaning                                                                              |\n| ------------------- | ----------- | ------------------------------------------------------------------------------------ |\n| `VALIDATION_FAILED` | 422         | Part of the request is not valid. Correct what the response names and send it again. |","table":"table-3"},"7872":{"id":"/docs/api/latest/workflows-versions-get-31","page_id":"/docs/api/latest/workflows-versions-get","tags":[],"type":"text","url":"/docs/api/latest/workflows-versions-get#errors","content":"| Code              | HTTP status | Meaning                                                                                         |\n| ----------------- | ----------- | ----------------------------------------------------------------------------------------------- |\n| `VERSION_UNKNOWN` | 400         | This API does not serve the version you asked for. Send one of the dates in published_versions. |","table":"table-3"},"7873":{"id":"/docs/command-line","page_id":"/docs/command-line","type":"page","content":"Command line","breadcrumbs":["Docs"],"tags":[],"url":"/docs/command-line"},"7874":{"id":"/docs/command-line-0","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line","content":"Sign in, do everyday tasks, script with output and exit codes, and fix common problems."},"7875":{"id":"/docs/command-line-1","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#quick-start","content":"Quick start"},"7876":{"id":"/docs/command-line-2","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#sign-in-and-choose-an-organization","content":"Sign in and choose an organization"},"7877":{"id":"/docs/command-line-3","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#sign-in","content":"Sign in"},"7878":{"id":"/docs/command-line-4","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#choose-an-organization","content":"Choose an organization"},"7879":{"id":"/docs/command-line-5","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#everyday-tasks","content":"Everyday tasks"},"7880":{"id":"/docs/command-line-6","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#work-through-a-ticket","content":"Work through a ticket"},"7881":{"id":"/docs/command-line-7","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#find-tickets","content":"Find tickets"},"7882":{"id":"/docs/command-line-8","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#scripting","content":"Scripting"},"7883":{"id":"/docs/command-line-9","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#output-formats","content":"Output formats"},"7884":{"id":"/docs/command-line-10","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#pick-values-with---query","content":"Pick values with `--query`"},"7885":{"id":"/docs/command-line-11","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#long-lists","content":"Long lists"},"7886":{"id":"/docs/command-line-12","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#exit-codes","content":"Exit codes"},"7887":{"id":"/docs/command-line-13","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#retries-and-idempotency","content":"Retries and idempotency"},"7888":{"id":"/docs/command-line-14","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#errors-you-can-branch-on","content":"Errors you can branch on"},"7889":{"id":"/docs/command-line-15","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#agents","content":"Agents"},"7890":{"id":"/docs/command-line-16","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#the-agent-skill","content":"The agent skill"},"7891":{"id":"/docs/command-line-17","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#what-your-agent-may-do-without-asking","content":"What your agent may do without asking"},"7892":{"id":"/docs/command-line-18","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#what-your-agent-can-read","content":"What your agent can read"},"7893":{"id":"/docs/command-line-19","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#flags-and-bodies","content":"Flags and bodies"},"7894":{"id":"/docs/command-line-20","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#flags","content":"Flags"},"7895":{"id":"/docs/command-line-21","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#text-from-a-file-or-the-editor","content":"Text from a file or the editor"},"7896":{"id":"/docs/command-line-22","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#bodies","content":"Bodies"},"7897":{"id":"/docs/command-line-23","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#environment-variables","content":"Environment variables"},"7898":{"id":"/docs/command-line-24","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#troubleshooting","content":"Troubleshooting"},"7899":{"id":"/docs/command-line-25","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#sign-in-on-a-linux-server","content":"Sign in on a Linux server"},"7900":{"id":"/docs/command-line-26","page_id":"/docs/command-line","type":"heading","tags":[],"url":"/docs/command-line#commands","content":"Commands"},"7901":{"id":"/docs/command-line-27","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line","content":"Work with your STLabs organization from your terminal or a script."},"7902":{"id":"/docs/command-line-28","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#quick-start","content":"Install `stlabs` first. The Install page has the steps, and `stlabs --version` shows what you have. Your organization's slug is the short name after `/org/` in your STLabs web address. It is often different from the display name, so copy it from the address. Then sign in, choose your organization, and list the open tickets you requested:"},"7903":{"id":"/docs/command-line-29","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#quick-start","content":"`stlabs login` opens your browser. Sign in with your usual account. On a Linux server with no keyring running, `stlabs login --device` fails with `the keychain is not available`, so follow Sign in on a Linux server instead. On any other machine with no browser, use `stlabs login --device`. Sign in covers every way to sign in."},"7904":{"id":"/docs/command-line-30","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#quick-start","content":"`stlabs org set` does not check the slug, so a wrong one fails on the first command that calls the API. Troubleshooting shows what that looks like."},"7905":{"id":"/docs/command-line-31","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#quick-start","content":"The last command prints a table of your open tickets, newest first:"},"7906":{"id":"/docs/command-line-32","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#quick-start","content":"To let an AI agent use `stlabs`, run `stlabs setup`. See Agents."},"7907":{"id":"/docs/command-line-33","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in","content":"| To sign in with | Run            | Use it for         |\n| --------------- | -------------- | ------------------ |\n| A browser       | `stlabs login` | Your own computer. |","table":"table-0"},"7908":{"id":"/docs/command-line-34","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in","content":"| To sign in with | Run                     | Use it for                                                                                 |\n| --------------- | ----------------------- | ------------------------------------------------------------------------------------------ |\n| A code          | `stlabs login --device` | A machine with no browser. Open the address it prints on another device and type the code. |","table":"table-0"},"7909":{"id":"/docs/command-line-35","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in","content":"| To sign in with | Run                         | Use it for                         |\n| --------------- | --------------------------- | ---------------------------------- |\n| A token         | `stlabs login --with-token` | A script that already has a token. |","table":"table-0"},"7910":{"id":"/docs/command-line-36","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in","content":"Signing in saves a session in your keychain. On Linux, the keychain is a keyring that the Secret Service provides, and a server often has none: see Sign in on a Linux server. Before any command that calls the API, `stlabs` refreshes a browser or device session. You sign in again only when that session expires or is revoked. A token you paste with `--with-token` is stored as it is and is not refreshed, so replace it when it expires."},"7911":{"id":"/docs/command-line-37","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in","content":"`--with-token` reads the token from standard input. It refuses a token given as an argument, because the argument would end up in your shell history:"},"7912":{"id":"/docs/command-line-38","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in","content":"In CI and scripts, set `STLABS_TOKEN` instead. It takes precedence over the saved session. Get a token with `stlabs auth token` on a computer where you are signed in. It expires, so it suits short jobs."},"7913":{"id":"/docs/command-line-39","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in","content":"To check or end a session, use these commands:"},"7914":{"id":"/docs/command-line-40","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in","content":"| Command         | What it does                                                                                                                                                                                                                               |\n| --------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `stlabs status` | Shows the host, who is signed in and how (a browser, a device code, a pasted token or `STLABS_TOKEN`), the organization, and whether your agent may write without asking (`agent writes`, see Agents). Exits 1 when you are not signed in. |","table":"table-1"},"7915":{"id":"/docs/command-line-41","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in","content":"| Command         | What it does                                                                          |\n| --------------- | ------------------------------------------------------------------------------------- |\n| `stlabs whoami` | Prints your email on one line, or nothing when the token does not belong to a person. |","table":"table-1"},"7916":{"id":"/docs/command-line-42","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in","content":"| Command             | What it does                                                                                                                                                                                           |\n| ------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `stlabs auth token` | Prints the current access token for a script. It refreshes a browser session that is about to expire first. When the token comes from `STLABS_TOKEN` or `--with-token`, it prints that token as it is. |","table":"table-1"},"7917":{"id":"/docs/command-line-43","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in","content":"| Command         | What it does                                                                                                                                              |\n| --------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `stlabs logout` | Revokes a browser or device session and removes any saved sign-in from the keychain. A token you pasted is removed here but stays valid until it expires. |","table":"table-1"},"7918":{"id":"/docs/command-line-44","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#choose-an-organization","content":"Every call acts on one organization. `stlabs org set <slug>` saves it and `stlabs org status` shows it. `STLABS_ORGANIZATION` takes precedence over the saved slug, so CI and scripts can set it without writing a file."},"7919":{"id":"/docs/command-line-45","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#choose-an-organization","content":"The slug is not a secret. `stlabs` keeps it in a settings file, `~/.config/stlabs/config.json` by default, and not in the keychain. Environment variables lists how to use a different path."},"7920":{"id":"/docs/command-line-46","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#work-through-a-ticket","content":"These commands file a ticket, read it, edit it, comment, resolve it and list tickets. The last command files the first ticket again with the same idempotency key, which Retries and idempotency explains. Replace `dana@northwind.example` with the email of someone in your organization, or to file for yourself, use `--requester me` in place of `--requester-email`. A Linux machine without `uuidgen` can make a key with `cat /proc/sys/kernel/random/uuid`. The `northwind` organization is sample data, not a real organization."},"7921":{"id":"/docs/command-line-47","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#work-through-a-ticket","content":"The last command returns the first ticket's original response and files nothing new. Retries and idempotency explains why."},"7922":{"id":"/docs/command-line-48","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#work-through-a-ticket","content":"To open a ticket in your web browser, run `stlabs tickets get <id> --web`. It prints the address instead when there is no browser to open."},"7923":{"id":"/docs/command-line-49","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#find-tickets","content":"`stlabs tickets list` takes a text search and filters. They combine, and each one narrows the list. The newest tickets come first. A search that matches nothing succeeds with an empty list."},"7924":{"id":"/docs/command-line-50","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#find-tickets","content":"| Flag       | What it takes                                                                                        |\n| ---------- | ---------------------------------------------------------------------------------------------------- |\n| `--search` | Text to find in the title, description and ticket id. It ignores case and matches the text as typed. |","table":"table-2"},"7925":{"id":"/docs/command-line-51","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#find-tickets","content":"| Flag                        | What it takes                                                                                                                                                 |\n| --------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--assignee`, `--requester` | `me`, which is whoever is signed in (`stlabs status` shows who), or a person id. A person id is the `id` of the `assignee` or `requester` on a listed ticket. |","table":"table-2"},"7926":{"id":"/docs/command-line-52","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#find-tickets","content":"| Flag         | What it takes                                 |\n| ------------ | --------------------------------------------- |\n| `--priority` | A slug from `stlabs tickets priorities list`. |","table":"table-2"},"7927":{"id":"/docs/command-line-53","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#find-tickets","content":"| Flag      | What it takes                             |\n| --------- | ----------------------------------------- |\n| `--state` | A slug from `stlabs tickets states list`. |","table":"table-2"},"7928":{"id":"/docs/command-line-54","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#find-tickets","content":"| Flag                                  | What it takes                                                                                                                                                                                                                 |\n| ------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `--created-after`, `--created-before` | A date such as `2026-10-01`, which means midnight UTC, or a full time such as `2026-10-01T00:00:00Z`. `--created-after` includes the time and `--created-before` does not. `--created-before 2026-10-31` leaves out the 31st. |","table":"table-2"},"7929":{"id":"/docs/command-line-55","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#output-formats","content":"On a terminal, `stlabs` shows what a person needs:"},"7930":{"id":"/docs/command-line-56","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#output-formats","content":"A command that lists records prints a table. It shows the columns you need to pick a record and shortens the longest column, such as the title, to fit the window."},"7931":{"id":"/docs/command-line-57","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#output-formats","content":"A command with a readable view, such as `stlabs tickets get`, shows one record."},"7932":{"id":"/docs/command-line-58","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#output-formats","content":"A command that changes something prints one line saying what changed, then the command to run next."},"7933":{"id":"/docs/command-line-59","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#output-formats","content":"Any other command prints JSON."},"7934":{"id":"/docs/command-line-60","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#output-formats","content":"The readable view and the success line appear only when the call succeeded. In a narrow window, a long text column moves to a second line. The row starts with `●` and its text follows `└`. Ticket ids in lists, in the ticket view and in the line after you file or change a ticket are links to the ticket, in terminals that can show links."},"7935":{"id":"/docs/command-line-61","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#output-formats","content":"When the output is piped or redirected, `stlabs` prints JSON on one line that ends with a newline. A `--query` result that is JSON is indented. `--output` picks another format on a terminal or in a pipe:"},"7936":{"id":"/docs/command-line-62","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#output-formats","content":"| `--output` | Prints                |\n| ---------- | --------------------- |\n| `json`     | The response as JSON. |","table":"table-3"},"7937":{"id":"/docs/command-line-63","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#output-formats","content":"| `--output` | Prints                |\n| ---------- | --------------------- |\n| `yaml`     | The response as YAML. |","table":"table-3"},"7938":{"id":"/docs/command-line-64","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#output-formats","content":"| `--output` | Prints                                                                                                                                                                                                                    |\n| ---------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `table`    | A list of objects as a table, or one record as a key-value table with nested keys joined by dots. The table is as wide as `$COLUMNS`, or the window, or 80 columns when piped with no `$COLUMNS`. Piped, it has no color. |","table":"table-3"},"7939":{"id":"/docs/command-line-65","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#output-formats","content":"| `--output` | Prints                                  |\n| ---------- | --------------------------------------- |\n| `lines`    | One value per line. It needs `--query`. |","table":"table-3"},"7940":{"id":"/docs/command-line-66","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#output-formats","content":"With no `--output`, a `--query` result that is text prints as text and anything else as JSON. An object that a query builds keeps its fields in the order the query lists them, in JSON, YAML and table columns. The fields of an object the API sent come back in alphabetical order."},"7941":{"id":"/docs/command-line-67","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#output-formats","content":"On a terminal, control characters in text printed with `--query` or `--output` show as escapes such as `\\x1b`. Tabs and line breaks stay as they are. Piped, the text is exactly as the API sent it."},"7942":{"id":"/docs/command-line-68","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"`--query` selects part of the response with a JMESPath expression. The expression starts from the whole response, which has `status`, `headers` and `body`. For example, `--query body.id` prints the id alone. The examples above use it to capture a new ticket's id."},"7943":{"id":"/docs/command-line-69","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"| To get    | Write             |\n| --------- | ----------------- |\n| One field | `--query body.id` |","table":"table-4"},"7944":{"id":"/docs/command-line-70","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"| To get                 | Write                                 |\n| ---------------------- | ------------------------------------- |\n| A field inside a field | `--query body.requester.display_name` |","table":"table-4"},"7945":{"id":"/docs/command-line-71","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"| To get             | Write                                                         |\n| ------------------ | ------------------------------------------------------------- |\n| One item of a list | `--query 'body.items[0]'`, or `'body.items[-1]'` for the last |","table":"table-4"},"7946":{"id":"/docs/command-line-72","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"| To get              | Write                                                 |\n| ------------------- | ----------------------------------------------------- |\n| The first two items | `--query 'body.items[0:2]'` (the end is not included) |","table":"table-4"},"7947":{"id":"/docs/command-line-73","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"| To get                  | Write                       |\n| ----------------------- | --------------------------- |\n| One field of every item | `--query 'body.items[].id'` |","table":"table-4"},"7948":{"id":"/docs/command-line-74","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"| To get               | Write                                  |\n| -------------------- | -------------------------------------- |\n| The items that match | `--query \"body.items[?state=='open']\"` |","table":"table-4"},"7949":{"id":"/docs/command-line-75","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"| To get                    | Write                                           |\n| ------------------------- | ----------------------------------------------- |\n| Some fields of every item | `--query 'body.items[].{id: id, state: state}'` |","table":"table-4"},"7950":{"id":"/docs/command-line-76","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"| To get         | Write                          |\n| -------------- | ------------------------------ |\n| How many items | `--query 'length(body.items)'` |","table":"table-4"},"7951":{"id":"/docs/command-line-77","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"| To get                  | Write                                                       |\n| ----------------------- | ----------------------------------------------------------- |\n| A header, or the status | `--query 'headers.\"Idempotent-Replayed\"'`, `--query status` |","table":"table-4"},"7952":{"id":"/docs/command-line-78","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"Inside the query:"},"7953":{"id":"/docs/command-line-79","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"Write text in a condition in single quotes, as in `state=='open'`."},"7954":{"id":"/docs/command-line-80","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"Double quotes name a field. That is how you write a header with a dash in its name."},"7955":{"id":"/docs/command-line-81","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"Write a number in a condition in backticks, as in `` [?n > `2`] ``."},"7956":{"id":"/docs/command-line-82","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"Compare with `==`, `!=`, `<`, `<=`, `>` and `>=`. Join conditions with `&&`, `||` and `!`."},"7957":{"id":"/docs/command-line-83","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"Functions such as `length`, `sort_by`, `contains` and `starts_with` are available."},"7958":{"id":"/docs/command-line-84","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"In your shell, put the whole query in single quotes. When the query itself holds single quotes, put it in double quotes instead, as in `\"body.items[?state=='open']\"`. Inside double quotes, the shell runs anything in backticks as a command, so put a backslash before each backtick of a number, as in ``\"body.items[?state=='open' && n > \\`2\\`]\"``."},"7959":{"id":"/docs/command-line-85","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"`stlabs` checks the syntax of the query, the functions it calls and where it starts before it sends anything. A query that cannot run exits with 2 and nothing is sent, so a typo never makes a change and then prints `null`."},"7960":{"id":"/docs/command-line-86","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#pick-values-with---query","content":"If the query does not fit the response, such as `length` of a number, `stlabs` prints nothing and exits 1. That is found only after the response arrives. When the command made a change, the change is still saved: `stlabs` says `Your change was saved` and names the command that shows it. A well-formed query for a field the response lacks prints `null`."},"7961":{"id":"/docs/command-line-87","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#long-lists","content":"A list that takes `--limit` returns a set number of records by default, 25 for `stlabs tickets list`. Run `stlabs <command> --help` to see whether a list takes `--limit` and `--all`. When more records exist, `stlabs` prints a note on stderr after the table or the JSON, whatever you set for `--query` or `--output`. Stdout keeps only what you asked for. The note looks like this:"},"7962":{"id":"/docs/command-line-88","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#long-lists","content":"A second line, not shown here, is the command that carries on from the last record: your command again, with its own `--cursor`."},"7963":{"id":"/docs/command-line-89","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#long-lists","content":"| To get                | Use                                                                                                             |\n| --------------------- | --------------------------------------------------------------------------------------------------------------- |\n| More than the default | `--limit 250`, which fetches 250 records a request at a time and prints them as one table or one JSON response. |","table":"table-5"},"7964":{"id":"/docs/command-line-90","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#long-lists","content":"| To get                    | Use     |\n| ------------------------- | ------- |\n| Every record, up to 1,000 | `--all` |","table":"table-5"},"7965":{"id":"/docs/command-line-91","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#long-lists","content":"| To get                  | Use                |\n| ----------------------- | ------------------ |\n| More than 1,000 records | `--all --max 5000` |","table":"table-5"},"7966":{"id":"/docs/command-line-92","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#long-lists","content":"| To get           | Use                                                                                                        |\n| ---------------- | ---------------------------------------------------------------------------------------------------------- |\n| The next records | The printed command, or `--cursor` with the `next_cursor` from the JSON. Keep the same search and filters. |","table":"table-5"},"7967":{"id":"/docs/command-line-93","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#long-lists","content":"A run fetches records a request at a time and stops after 100 requests. A request holds up to 100 records for `stlabs tickets list`, so a run reaches 10,000 records. Other lists have their own request size, which `stlabs <command> --help` names. `stlabs` refuses a larger `--limit` or `--max` before it sends anything. It says what the ceiling is."},"7968":{"id":"/docs/command-line-94","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#long-lists","content":"The JSON is `{\"items\": [...], \"next_cursor\": ...}`, whether it holds one page or many. `next_cursor` follows the last record printed and is `null` at the end of the list. With `--query`, keep the cursor in the result: `--query '{ids: body.items[].id, next: body.next_cursor}'` returns `next` as `null` at the end."},"7969":{"id":"/docs/command-line-95","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#long-lists","content":"A run that ends with records left still exits 0, because it returned all it was asked or allowed to. That includes a run that stopped at the page cap, where stderr says `Stopped after 100 pages`. Check `next_cursor` to know whether more remain."},"7970":{"id":"/docs/command-line-96","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#long-lists","content":"With `--all`, `stlabs` applies a `--query` or `--output` once, to the merged response. So `--all --query 'body.items[].id'` prints the ids from every page. A query over several pages reads the `status` and `headers` of the last page. If a page fails partway, `stlabs` exits with that failure's code, says how many records it fetched, and prints no combined response."},"7971":{"id":"/docs/command-line-97","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#exit-codes","content":"`stlabs help exit-codes` prints the same table."},"7972":{"id":"/docs/command-line-98","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#exit-codes","content":"| exit | meaning |\n| ---- | ------- |\n| 0    | success |","table":"table-6"},"7973":{"id":"/docs/command-line-99","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#exit-codes","content":"| exit | meaning                                                                                                                |\n| ---- | ---------------------------------------------------------------------------------------------------------------------- |\n| 1    | not signed in, no organization set, a response that could not be read (empty, or not from the API), or a network error |","table":"table-6"},"7974":{"id":"/docs/command-line-100","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#exit-codes","content":"| exit | meaning                                                                          |\n| ---- | -------------------------------------------------------------------------------- |\n| 2    | a usage error: an unknown command or option, a query or body that cannot be used |","table":"table-6"},"7975":{"id":"/docs/command-line-101","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#exit-codes","content":"| exit | meaning                                           |\n| ---- | ------------------------------------------------- |\n| 3    | the API answered with a redirect (a 3xx response) |","table":"table-6"},"7976":{"id":"/docs/command-line-102","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#exit-codes","content":"| exit | meaning                                                                                                                                                        |\n| ---- | -------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| 4    | the API refused the request (a 4xx response); retry only when the response says it is retryable, after any wait it names, and retry a change with the same key |","table":"table-6"},"7977":{"id":"/docs/command-line-103","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#exit-codes","content":"| exit | meaning                                                                  |\n| ---- | ------------------------------------------------------------------------ |\n| 5    | the API failed (a 5xx response); a change may or may not have been saved |","table":"table-6"},"7978":{"id":"/docs/command-line-104","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#exit-codes","content":"| exit | meaning                                                                                                                                                                  |\n| ---- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| 11   | the API no longer serves what this stlabs asks for: an API version it dropped (install the latest stlabs) or a command it removed (stlabs --help shows what replaces it) |","table":"table-6"},"7979":{"id":"/docs/command-line-105","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#exit-codes","content":"A 404, such as an unknown ticket, is exit 4. Exit 11 means the API changed, not that you made a mistake: see Troubleshooting."},"7980":{"id":"/docs/command-line-106","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#retries-and-idempotency","content":"**What `stlabs` retries.** A command that gets or lists records is retried twice on a 429 or 5xx response or a network error. It is not retried when the error says `retryable` is false."},"7981":{"id":"/docs/command-line-107","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#retries-and-idempotency","content":"It waits as long as `Retry-After` asks, up to 12 seconds, plus up to a quarter more so that callers refused together do not come back together. The wait is never more than 15 seconds."},"7982":{"id":"/docs/command-line-108","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#retries-and-idempotency","content":"When `Retry-After` asks for more than 12 seconds, `stlabs` does not wait. It exits with the response's own code (4 for a 429) and says how long to wait."},"7983":{"id":"/docs/command-line-109","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#retries-and-idempotency","content":"Each retry prints `warning: retry 1/2 in <wait>` on stderr."},"7984":{"id":"/docs/command-line-110","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#retries-and-idempotency","content":"A command that changes something is never retried automatically, and neither are `stlabs people availability search`, `stlabs queues search`, `stlabs tickets counts get` and `stlabs tickets translations list`, which read with a POST."},"7985":{"id":"/docs/command-line-111","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#retries-and-idempotency","content":"**After a failure.** A 5xx response or a network failure often leaves it unclear whether a change landed. `stlabs` names the read that shows it, such as `stlabs tickets comments list <ticket>` for a comment. It tells you to check before you run the change again. When the host cannot be reached at all, because the host refused the call or its name was not found, nothing was sent, and `stlabs` says so."},"7986":{"id":"/docs/command-line-112","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#retries-and-idempotency","content":"**Idempotency keys.** An idempotency key is a string that tells the API two requests are the same change. Every command that changes something is sent with one. `stlabs` makes a new key on each run, so running a command twice makes two changes. To make a retry safe, choose the key yourself with `--idempotency-key <key>`."},"7987":{"id":"/docs/command-line-113","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#retries-and-idempotency","content":"For a day after a key is first used, the same key never makes a second change:"},"7988":{"id":"/docs/command-line-114","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#retries-and-idempotency","content":"| You send                       | You get                                                                                                  |\n| ------------------------------ | -------------------------------------------------------------------------------------------------------- |\n| The same key and the same body | The original response, with the same `id` and status and the header `Idempotent-Replayed` set to `true`. |","table":"table-7"},"7989":{"id":"/docs/command-line-115","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#retries-and-idempotency","content":"| You send                                                                     | You get                                        |\n| ---------------------------------------------------------------------------- | ---------------------------------------------- |\n| The same key while the first attempt is unfinished or its outcome is unknown | A refusal that says to wait or to check first. |","table":"table-7"},"7990":{"id":"/docs/command-line-116","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#retries-and-idempotency","content":"| You send                          | You get                                             |\n| --------------------------------- | --------------------------------------------------- |\n| The same key and a different body | A refusal with the code `IDEMPOTENCY_KEY_MISMATCH`. |","table":"table-7"},"7991":{"id":"/docs/command-line-117","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#retries-and-idempotency","content":"When a change fails in a way that is safe to retry, `stlabs` prints the command to retry with, key included, on a line of its own. A refusal because too many keys are in use prints no command. The same key does not help until older keys expire."},"7992":{"id":"/docs/command-line-118","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#errors-you-can-branch-on","content":"A failed call exits non-zero, and never prints an error where a value should be. Where the error goes depends on how you ran the command:"},"7993":{"id":"/docs/command-line-119","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#errors-you-can-branch-on","content":"| How you ran it                              | What you get                                                                                                                                                                            |\n| ------------------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Piped, or with `--output`, and no `--query` | The error body on stdout. Piped, it is exactly as the API sent it. With `--output json` or `yaml` it has the same fields in that format. With `--output table` it is a key-value table. |","table":"table-8"},"7994":{"id":"/docs/command-line-120","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#errors-you-can-branch-on","content":"| How you ran it                                 | What you get                                                                                                             |\n| ---------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------ |\n| On a terminal, with no `--output` or `--query` | A line on stderr that says what went wrong and what to do, then `request id: <id>`. Quote that id when you ask for help. |","table":"table-8"},"7995":{"id":"/docs/command-line-121","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#errors-you-can-branch-on","content":"| How you ran it | What you get                                                                                                     |\n| -------------- | ---------------------------------------------------------------------------------------------------------------- |\n| With `--query` | Nothing on stdout, and the error body on stderr. This keeps an error from being read as the value you asked for. |","table":"table-8"},"7996":{"id":"/docs/command-line-122","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#errors-you-can-branch-on","content":"The exit code stays the same in every case. Check it, as in `ID=$(stlabs ...) || exit`, and not whether any output came back."},"7997":{"id":"/docs/command-line-123","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#errors-you-can-branch-on","content":"The error body has these fields:"},"7998":{"id":"/docs/command-line-124","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#errors-you-can-branch-on","content":"| Field  | What it holds                                               |\n| ------ | ----------------------------------------------------------- |\n| `code` | What went wrong, such as `NOT_FOUND`. Stable. Branch on it. |","table":"table-9"},"7999":{"id":"/docs/command-line-125","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#errors-you-can-branch-on","content":"| Field    | What it holds                             |\n| -------- | ----------------------------------------- |\n| `reason` | A finer cause, where one applies. Stable. |","table":"table-9"},"8000":{"id":"/docs/command-line-126","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#errors-you-can-branch-on","content":"| Field       | What it holds                     |\n| ----------- | --------------------------------- |\n| `retryable` | Whether a retry can work. Stable. |","table":"table-9"},"8001":{"id":"/docs/command-line-127","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#errors-you-can-branch-on","content":"| Field        | What it holds                                                         |\n| ------------ | --------------------------------------------------------------------- |\n| `next_steps` | What to do. Each step has a `kind`, such as `allowed_values`. Stable. |","table":"table-9"},"8002":{"id":"/docs/command-line-128","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#errors-you-can-branch-on","content":"| Field            | What it holds                                  |\n| ---------------- | ---------------------------------------------- |\n| `detail`, `hint` | Text for people. It can change in any release. |","table":"table-9"},"8003":{"id":"/docs/command-line-129","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#agents","content":"`stlabs setup` gets you and your AI agent ready in one command. On a terminal it:"},"8004":{"id":"/docs/command-line-130","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#agents","content":"Offers to sign you in. `--device` signs in with a code instead of the browser."},"8005":{"id":"/docs/command-line-131","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#agents","content":"Picks your organization. After a browser sign-in it uses the one you are signed into on the web. It asks only when that does not settle it."},"8006":{"id":"/docs/command-line-132","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#agents","content":"Installs the agent skill."},"8007":{"id":"/docs/command-line-133","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#agents","content":"Asks whether your agent may file tickets and add comments without asking you first."},"8008":{"id":"/docs/command-line-134","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#agents","content":"Ends by telling you what to ask your agent first, or the command still left to run."},"8009":{"id":"/docs/command-line-135","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#agents","content":"A step that is already done is skipped, so you can run `stlabs setup` again at any time. With `-y`, or with no terminal, it asks nothing and prints one `key: value` line for each step, with `next:` for what is left. Add `--output json` to print the result as JSON."},"8010":{"id":"/docs/command-line-136","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#agents","content":"`stlabs setup --status` prints the same lines and changes nothing. It exits 0 when the skill is current in every folder, and 1 otherwise. A missing sign-in or organization does not change the exit code. A relative `CLAUDE_CONFIG_DIR` is refused with exit code 2."},"8011":{"id":"/docs/command-line-137","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#the-agent-skill","content":"The skill is a set of instruction files that tells Claude Code and other agents how to use `stlabs`. Installing it sends nothing and never edits an agent's settings. It goes into these folders:"},"8012":{"id":"/docs/command-line-138","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#the-agent-skill","content":"`~/.claude/skills/stlabs-cli`"},"8013":{"id":"/docs/command-line-139","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#the-agent-skill","content":"`~/.agents/skills/stlabs-cli`"},"8014":{"id":"/docs/command-line-140","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#the-agent-skill","content":"When `CLAUDE_CONFIG_DIR` is set to an absolute path, the first folder is `$CLAUDE_CONFIG_DIR/skills/stlabs-cli`. If `setup` creates `~/.claude/skills` for the first time, a Claude Code session that is already running needs `/reload-skills`."},"8015":{"id":"/docs/command-line-141","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#the-agent-skill","content":"`--status` reports one of four states for each folder:"},"8016":{"id":"/docs/command-line-142","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#the-agent-skill","content":"| State   | What `setup` does |\n| ------- | ----------------- |\n| Current | Nothing.          |","table":"table-10"},"8017":{"id":"/docs/command-line-143","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#the-agent-skill","content":"| State    | What `setup` does |\n| -------- | ----------------- |\n| Outdated | Replaces it.      |","table":"table-10"},"8018":{"id":"/docs/command-line-144","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#the-agent-skill","content":"| State                          | What `setup` does                                                                                                                                    |\n| ------------------------------ | ---------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Changed since it was installed | On a terminal, asks before it replaces your edited copy. `-y` replaces it without asking. With no terminal and no `-y`, it leaves the copy as it is. |","table":"table-10"},"8019":{"id":"/docs/command-line-145","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#the-agent-skill","content":"| State         | What `setup` does |\n| ------------- | ----------------- |\n| Not installed | Installs it.      |","table":"table-10"},"8020":{"id":"/docs/command-line-146","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#the-agent-skill","content":"If you keep an edited copy, `setup` skips the question about tickets and comments."},"8021":{"id":"/docs/command-line-147","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#what-your-agent-may-do-without-asking","content":"`setup` asks whether your agent may file tickets and add comments without asking you first:"},"8022":{"id":"/docs/command-line-148","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#what-your-agent-may-do-without-asking","content":"| Answer                  | What the agent does                              |\n| ----------------------- | ------------------------------------------------ |\n| `confirm` (the default) | Asks before it files a ticket or adds a comment. |","table":"table-11"},"8023":{"id":"/docs/command-line-149","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#what-your-agent-may-do-without-asking","content":"| Answer    | What the agent does                    |\n| --------- | -------------------------------------- |\n| `routine` | Files tickets and comments on its own. |","table":"table-11"},"8024":{"id":"/docs/command-line-150","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#what-your-agent-may-do-without-asking","content":"Whatever you choose, the skill tells the agent to ask before it resolves, updates or deletes anything, or makes a bulk change. The skill only asks the agent to stop. Your agent tool's own permission prompts are the check that holds."},"8025":{"id":"/docs/command-line-151","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#what-your-agent-may-do-without-asking","content":"Run `setup` again and it shows your answer and asks whether to change it. To set it without a question, use `--agent-writes confirm` or `--agent-writes routine`. With `-y`, `setup` keeps the setting you have, or `confirm` if there is none. `stlabs status` and `stlabs setup --status` show it as `agent writes`."},"8026":{"id":"/docs/command-line-152","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#what-your-agent-can-read","content":"`stlabs agent schema` prints the commands of the `stlabs` installed on this machine. An agent can read them even when its skill is older than `stlabs`. It needs no sign-in and sends nothing. It prints JSON when piped or with `--output json`, and text on a terminal."},"8027":{"id":"/docs/command-line-153","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#what-your-agent-can-read","content":"| Command                              | Prints                                                                      |\n| ------------------------------------ | --------------------------------------------------------------------------- |\n| `stlabs agent schema tickets create` | One command: its flags, fields, examples, and when it is safe to run again. |","table":"table-12"},"8028":{"id":"/docs/command-line-154","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#what-your-agent-can-read","content":"| Command                       | Prints                                      |\n| ----------------------------- | ------------------------------------------- |\n| `stlabs agent schema tickets` | A group: each command with its field names. |","table":"table-12"},"8029":{"id":"/docs/command-line-155","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#what-your-agent-can-read","content":"| Command                               | Prints                                                |\n| ------------------------------------- | ----------------------------------------------------- |\n| `stlabs agent schema --search <word>` | The commands whose names or summaries match the word. |","table":"table-12"},"8030":{"id":"/docs/command-line-156","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#what-your-agent-can-read","content":"Run without a name, it lists every command of `stlabs`. For commands that `stlabs` answers itself, such as `login` and `setup`, it prints their usage."},"8031":{"id":"/docs/command-line-157","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#flags","content":"A command takes only the options its `--help` lists. `stlabs <command> --help` lists every flag, the keys of each object and the field each flag sets."},"8032":{"id":"/docs/command-line-158","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#flags","content":"Every field that takes a value has a flag, named after the field with `_` written as `-`: `--title`, `--priority`, `--queue`, `--assignee` and the rest."},"8033":{"id":"/docs/command-line-159","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#flags","content":"| For                              | Write                                                                                     |\n| -------------------------------- | ----------------------------------------------------------------------------------------- |\n| A field that offers alternatives | A flag named after the alternative you pick. `stlabs tickets transition` takes `--state`. |","table":"table-13"},"8034":{"id":"/docs/command-line-160","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#flags","content":"| For                                   | Write                                                           |\n| ------------------------------------- | --------------------------------------------------------------- |\n| A list you can add to and remove from | A flag for each verb: `--add-follower` and `--remove-follower`. |","table":"table-13"},"8035":{"id":"/docs/command-line-161","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#flags","content":"| For                       | Write                                                                                                                                                                              |\n| ------------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| The settings of an object | One flag named for the object, with a key for each setting: `--awaiting-reply close-hours=48 --awaiting-reply then=cancel`. The value is everything after the first `=`, as typed. |","table":"table-13"},"8036":{"id":"/docs/command-line-162","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#flags","content":"| For                               | Write                                                                                  |\n| --------------------------------- | -------------------------------------------------------------------------------------- |\n| A field that holds several values | The flag once for each value. Ids may also be separated by commas. Free text never is. |","table":"table-13"},"8037":{"id":"/docs/command-line-163","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#flags","content":"| For                   | Write                                                  |\n| --------------------- | ------------------------------------------------------ |\n| A true or false field | The flag alone for true, and `--flag=false` for false. |","table":"table-13"},"8038":{"id":"/docs/command-line-164","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#flags","content":"| For                            | Write                                                   |\n| ------------------------------ | ------------------------------------------------------- |\n| A field that can be left empty | `--clear <field>` unsets it. Repeat it for more fields. |","table":"table-13"},"8039":{"id":"/docs/command-line-165","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#flags","content":"`stlabs` sends the value of a flag exactly as given. Commas, colons, quotes, `@me` and text that looks like a number need no quoting except your shell's. A body follows different quoting rules: see Bodies."},"8040":{"id":"/docs/command-line-166","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#text-from-a-file-or-the-editor","content":"A comment, a description, a reason or a note takes `--body`, `--description`, `--reason` or `--note`. Add `-file` to the name to read the text from a file, or from standard input with `-`. The text is sent exactly as given, with its commas, quotes, brackets and line breaks."},"8041":{"id":"/docs/command-line-167","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#text-from-a-file-or-the-editor","content":"Keep text in one shell argument, as in `--body 'Thanks, that fixed it'`. To read a comment from a pipe, run `stlabs tickets comments create \"$ID\" --body-file -`."},"8042":{"id":"/docs/command-line-168","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#text-from-a-file-or-the-editor","content":"On a terminal, a comment with no text opens the editor named by `VISUAL` or `EDITOR`. With neither set, or with no terminal, the command stops with exit code 2 and says how to give the text."},"8043":{"id":"/docs/command-line-169","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#bodies","content":"A body is one argument of `field: value` pairs separated by commas. It goes after the other arguments, as in `stlabs tickets update <ticket> 'title: \"Filed, then edited\"'`. It is the only way to give a field that holds an object, such as `business_hours`."},"8044":{"id":"/docs/command-line-170","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#bodies","content":"Put the whole body in single quotes."},"8045":{"id":"/docs/command-line-171","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#bodies","content":"Put a value in double quotes if it contains a comma, starts with `@`, looks like a number, is `true`, `false` or `null`, or starts with `[` or `{`. Unquoted, those are sent as something other than text."},"8046":{"id":"/docs/command-line-172","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#bodies","content":"Give a field by its flag or in the body, not both."},"8047":{"id":"/docs/command-line-173","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#bodies","content":"A word after the body is refused rather than added to it."},"8048":{"id":"/docs/command-line-174","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#bodies","content":"| You want             | Write                           |\n| -------------------- | ------------------------------- |\n| A title with a comma | `'title: \"Filed, then edited\"'` |","table":"table-14"},"8049":{"id":"/docs/command-line-175","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#bodies","content":"| You want                 | Write            |\n| ------------------------ | ---------------- |\n| A title that is a number | `'title: \"123\"'` |","table":"table-14"},"8050":{"id":"/docs/command-line-176","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#bodies","content":"| You want                      | Write             |\n| ----------------------------- | ----------------- |\n| A title that is the word true | `'title: \"true\"'` |","table":"table-14"},"8051":{"id":"/docs/command-line-177","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#bodies","content":"| You want                                    | Write               |\n| ------------------------------------------- | ------------------- |\n| An assignee of `@me`, which starts with `@` | `'assignee: \"@me\"'` |","table":"table-14"},"8052":{"id":"/docs/command-line-178","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#environment-variables","content":"| Variable       | What it does                                   |\n| -------------- | ---------------------------------------------- |\n| `STLABS_TOKEN` | The token to use instead of the saved session. |","table":"table-15"},"8053":{"id":"/docs/command-line-179","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#environment-variables","content":"| Variable              | What it does                                                           |\n| --------------------- | ---------------------------------------------------------------------- |\n| `STLABS_ORGANIZATION` | The organization to act on. It takes precedence over `stlabs org set`. |","table":"table-15"},"8054":{"id":"/docs/command-line-180","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#environment-variables","content":"| Variable        | What it does                                                                                              |\n| --------------- | --------------------------------------------------------------------------------------------------------- |\n| `STLABS_CONFIG` | The path of the settings file. The default is `config.json` in a `stlabs` folder under `XDG_CONFIG_HOME`. |","table":"table-15"},"8055":{"id":"/docs/command-line-181","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#environment-variables","content":"| Variable          | What it does                                                                                         |\n| ----------------- | ---------------------------------------------------------------------------------------------------- |\n| `XDG_CONFIG_HOME` | Where the `stlabs` settings folder goes when `STLABS_CONFIG` is not set. The default is `~/.config`. |","table":"table-15"},"8056":{"id":"/docs/command-line-182","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#environment-variables","content":"| Variable            | What it does                                                                                |\n| ------------------- | ------------------------------------------------------------------------------------------- |\n| `CLAUDE_CONFIG_DIR` | An absolute path that replaces `~/.claude` for the agent skill. A relative path is refused. |","table":"table-15"},"8057":{"id":"/docs/command-line-183","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#environment-variables","content":"| Variable   | What it does                                                                                                            |\n| ---------- | ----------------------------------------------------------------------------------------------------------------------- |\n| `NO_COLOR` | Any value except an empty one turns color off. This applies to tables and to `stlabs setup`. `TERM=dumb` does the same. |","table":"table-15"},"8058":{"id":"/docs/command-line-184","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#environment-variables","content":"| Variable            | What it does                                                                                          |\n| ------------------- | ----------------------------------------------------------------------------------------------------- |\n| `STLABS_HYPERLINKS` | `0` turns links off anywhere and `1` turns them on anywhere. By default, links follow the color rule. |","table":"table-15"},"8059":{"id":"/docs/command-line-185","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#environment-variables","content":"| Variable            | What it does                                                                       |\n| ------------------- | ---------------------------------------------------------------------------------- |\n| `STLABS_NO_NOTICES` | `1` hides every notice, including the warning about a command the API is retiring. |","table":"table-15"},"8060":{"id":"/docs/command-line-186","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#environment-variables","content":"| Variable           | What it does                                                                                                                                                                                                                                |\n| ------------------ | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `STLABS_TELEMETRY` | `stlabs` sends crash reports, and looks once a day for a notice, without being asked. `0` stops both, so no update notice is shown either. `print` shows each crash report without sending it. `DO_NOT_TRACK=1` has the same effect as `0`. |","table":"table-15"},"8061":{"id":"/docs/command-line-187","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#environment-variables","content":"| Variable  | What it does                                                                                                            |\n| --------- | ----------------------------------------------------------------------------------------------------------------------- |\n| `COLUMNS` | The width of tables, on a terminal and when piped. Without it, tables use the window's width, or 80 columns when piped. |","table":"table-15"},"8062":{"id":"/docs/command-line-188","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#environment-variables","content":"| Variable           | What it does                                      |\n| ------------------ | ------------------------------------------------- |\n| `VISUAL`, `EDITOR` | The editor that opens for a comment with no text. |","table":"table-15"},"8063":{"id":"/docs/command-line-189","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"| You see                 | Why                                                                                            | What to do                                 |\n| ----------------------- | ---------------------------------------------------------------------------------------------- | ------------------------------------------ |\n| `stlabs: not signed in` | You have no saved session, and `STLABS_TOKEN` is not set. `stlabs` sends nothing. Exit code 1. | Run `stlabs login`, or set `STLABS_TOKEN`. |","table":"table-16"},"8064":{"id":"/docs/command-line-190","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"| You see                                                              | Why                                                     | What to do          |\n| -------------------------------------------------------------------- | ------------------------------------------------------- | ------------------- |\n| `stlabs: your sign-in has expired or was revoked. Run stlabs login.` | Your saved session expired or was revoked. Exit code 1. | Run `stlabs login`. |","table":"table-16"},"8065":{"id":"/docs/command-line-191","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"| You see                                                                 | Why                                                                                                                                                                                                       | What to do                                                    |\n| ----------------------------------------------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ------------------------------------------------------------- |\n| A 401 from the API that ends `Run stlabs login, or check STLABS_TOKEN.` | The token in `STLABS_TOKEN` or your session is not accepted. Exit code 4. When the output is piped, the line reads `stlabs: the API refused the token (expired or invalid).` followed by the same advice. | Run `stlabs login` to sign in again, or check `STLABS_TOKEN`. |","table":"table-16"},"8066":{"id":"/docs/command-line-192","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"| You see                       | Why                                                                                               | What to do                   |\n| ----------------------------- | ------------------------------------------------------------------------------------------------- | ---------------------------- |\n| `stlabs: no organization set` | No saved organization, and `STLABS_ORGANIZATION` is not set. `stlabs` sends nothing. Exit code 1. | Run `stlabs org set <slug>`. |","table":"table-16"},"8067":{"id":"/docs/command-line-193","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"| You see                                                                       | Why                                                                                                                                         | What to do                                                                                              |\n| ----------------------------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------- | ------------------------------------------------------------------------------------------------------- |\n| A 403 `PERMISSION_DENIED` that says the slug is not one of your organizations | `stlabs org set` saves a slug without checking it, so a wrong one fails on the first call to the API. A display name is often not the slug. | Take the slug from the name after `/org/` in your STLabs web address, then run `stlabs org set <slug>`. |","table":"table-16"},"8068":{"id":"/docs/command-line-194","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"| You see                                                                 | Why                                      | What to do                                                                                                                                                                                                                         |\n| ----------------------------------------------------------------------- | ---------------------------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| A 403 with the code `PERMISSION_DENIED`, which says you are not allowed | You may have the wrong organization set. | Run `stlabs org status`, then `stlabs org set <slug>` if it is wrong. `stlabs` leaves this hint out when the refusal is about one field or one ticket, such as changing a title, because another organization would not change it. |","table":"table-16"},"8069":{"id":"/docs/command-line-195","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"| You see                                        | Why                                          | What to do                             |\n| ---------------------------------------------- | -------------------------------------------- | -------------------------------------- |\n| A 403 with the code `ORGANIZATION_NOT_ENABLED` | The API is not set up for your organization. | Email support@stlabs.com to set it up. |","table":"table-16"},"8070":{"id":"/docs/command-line-196","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"| You see                                           | Why                                                                                                           | What to do                                                            |\n| ------------------------------------------------- | ------------------------------------------------------------------------------------------------------------- | --------------------------------------------------------------------- |\n| A 403 with the code `ELIGIBILITY_REQUIRES_PERSON` | You are not signed in as a person in the organization you chose, often because the wrong organization is set. | Run `stlabs org status`, and sign in as yourself with `stlabs login`. |","table":"table-16"},"8071":{"id":"/docs/command-line-197","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"| You see                   | Why                         | What to do                                                                                                                |\n| ------------------------- | --------------------------- | ------------------------------------------------------------------------------------------------------------------------- |\n| `stlabs: unknown command` | The command does not exist. | Run `stlabs --help`. `stlabs` suggests the closest command when there is one, as in `Did you mean 'stlabs tickets list'?` |","table":"table-16"},"8072":{"id":"/docs/command-line-198","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"| You see                                                        | Why                              | What to do                                   |\n| -------------------------------------------------------------- | -------------------------------- | -------------------------------------------- |\n| Exit code 11 and a line that says the command has been removed | The API has retired the command. | Run `stlabs --help` to see what replaces it. |","table":"table-16"},"8073":{"id":"/docs/command-line-199","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"| You see                                                        | Why                                                         | What to do                   |\n| -------------------------------------------------------------- | ----------------------------------------------------------- | ---------------------------- |\n| Exit code 11 and a line that says to install the latest stlabs | The API has retired the API version this `stlabs` asks for. | Install the latest `stlabs`. |","table":"table-16"},"8074":{"id":"/docs/command-line-200","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"| You see                                                           | Why                                                                | What to do                               |\n| ----------------------------------------------------------------- | ------------------------------------------------------------------ | ---------------------------------------- |\n| `warning: 'stlabs tickets list' will stop working on 2027-03-14.` | The API is retiring that command. It keeps working until that day. | Install the latest `stlabs` before then. |","table":"table-16"},"8075":{"id":"/docs/command-line-201","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"| You see                                                                                                   | Why                                                                                                                                                                           | What to do                                                                                                         |\n| --------------------------------------------------------------------------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------ |\n| `stlabs: the keychain is not available.` Then, for a command that calls the API, `stlabs: not signed in.` | `stlabs` cannot read the keychain, so it finds no session. On Linux, no Secret Service is running, which is usual on a server. On macOS, the keychain is locked. Exit code 1. | On Linux, see Sign in on a Linux server. On macOS, unlock the keychain. In both, `STLABS_TOKEN` works without one. |","table":"table-16"},"8076":{"id":"/docs/command-line-202","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"When the API has retired a command or an API version, a terminal shows a short line. Piped, or with `--output`, the whole error body is printed, and the exit code is the signal."},"8077":{"id":"/docs/command-line-203","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#troubleshooting","content":"A retiring command prints its warning once per run, on stderr. A command the API is retiring without a date prints the same line, saying it is going away. A command the API has already retired does not warn. It fails with exit code 11. The warning is a notice, so it is not shown when output is piped or `--output` is given. `STLABS_NO_NOTICES=1` hides it."},"8078":{"id":"/docs/command-line-204","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in-on-a-linux-server","content":"On Linux, `stlabs` keeps your session in a keyring that the Secret Service provides. `stlabs login` with no terminal stops with `no token given`. `stlabs login --device` fails with `the keychain is not available` while no keyring is running. You have two ways to sign in."},"8079":{"id":"/docs/command-line-205","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in-on-a-linux-server","content":"**Copy a token from your own computer.** On a computer with a browser, run `stlabs login`, then run `stlabs auth token`. On the server, set its output as `STLABS_TOKEN` and set `STLABS_ORGANIZATION`. The token expires, so this suits a short job."},"8080":{"id":"/docs/command-line-206","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in-on-a-linux-server","content":"**Run a keyring on the server.** On Debian or Ubuntu, install the packages, start a shell under `dbus-run-session`, and unlock a keyring with a passphrase you choose. The passphrase is typed at a prompt, so it stays out of your shell history:"},"8081":{"id":"/docs/command-line-207","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in-on-a-linux-server","content":"Run your `stlabs` commands in that shell. The keyring lives in `~/.local/share/keyrings`, locked with that passphrase, and is open only while the shell runs. The next time you log in to the server, start the shell the same way (`dbus-run-session -- bash`, then the `read` and `eval` lines) with the same passphrase. You stay signed in."},"8082":{"id":"/docs/command-line-208","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#sign-in-on-a-linux-server","content":"To run a command without a shell that stays open, such as in a script, set `KEYRING_PASSPHRASE` to the passphrase and put the unlock in front of the command. It is an ordinary environment variable: set it in the shell or pass it to the job, and do not write it into the script. The first time, run `stlabs login --device` this way. Then run any other command the same way:"},"8083":{"id":"/docs/command-line-209","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"`stlabs` has these groups of commands:"},"8084":{"id":"/docs/command-line-210","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| Group     | What it covers                              |\n| --------- | ------------------------------------------- |\n| `tickets` | Create, find, update and comment on tickets |","table":"table-17"},"8085":{"id":"/docs/command-line-211","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| Group       | What it covers                             |\n| ----------- | ------------------------------------------ |\n| `approvals` | Review and answer approvals waiting on you |","table":"table-17"},"8086":{"id":"/docs/command-line-212","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| Group    | What it covers                                     |\n| -------- | -------------------------------------------------- |\n| `queues` | See and manage the queues that tickets are sent to |","table":"table-17"},"8087":{"id":"/docs/command-line-213","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| Group    | What it covers                          |\n| -------- | --------------------------------------- |\n| `people` | Check who is available to take a ticket |","table":"table-17"},"8088":{"id":"/docs/command-line-214","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| Group    | What it covers                                            |\n| -------- | --------------------------------------------------------- |\n| `access` | See who has access to what: roles, groups and permissions |","table":"table-17"},"8089":{"id":"/docs/command-line-215","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"| Group       | What it covers                                                             |\n| ----------- | -------------------------------------------------------------------------- |\n| `workflows` | See your workflows, turn them on or off, delete them and follow their runs |","table":"table-17"},"8090":{"id":"/docs/command-line-216","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"To see the commands:"},"8091":{"id":"/docs/command-line-217","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"`stlabs --help` lists the groups."},"8092":{"id":"/docs/command-line-218","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"`stlabs help commands` lists the commands of every group on one page. It works offline and when you are signed out."},"8093":{"id":"/docs/command-line-219","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"`stlabs tickets --help` lists the commands in a group."},"8094":{"id":"/docs/command-line-220","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"`stlabs tickets create --help` shows the arguments in order, the body fields and an example."},"8095":{"id":"/docs/command-line-221","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"The commands in these groups call the STLabs API. The rest are built into `stlabs`: `login`, `logout`, `status`, `whoami`, `org`, `setup`, `auth token`, `agent schema` and `help`. They manage your session, your settings and the agent skill."},"8096":{"id":"/docs/command-line-222","page_id":"/docs/command-line","tags":[],"type":"text","url":"/docs/command-line#commands","content":"The API reference lists every operation with its parameters, fields and error codes, and shows the matching `stlabs` command. The Versions page explains how `stlabs` and the API are versioned."},"8097":{"id":"/docs/crash-reports","page_id":"/docs/crash-reports","type":"page","content":"Crash reports","breadcrumbs":["Docs"],"tags":[],"url":"/docs/crash-reports"},"8098":{"id":"/docs/crash-reports-0","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports","content":"What stlabs saves and sends when a command stops unexpectedly, and how to turn it off."},"8099":{"id":"/docs/crash-reports-1","page_id":"/docs/crash-reports","type":"heading","tags":[],"url":"/docs/crash-reports#what-a-report-contains","content":"What a report contains"},"8100":{"id":"/docs/crash-reports-2","page_id":"/docs/crash-reports","type":"heading","tags":[],"url":"/docs/crash-reports#what-it-never-contains","content":"What it never contains"},"8101":{"id":"/docs/crash-reports-3","page_id":"/docs/crash-reports","type":"heading","tags":[],"url":"/docs/crash-reports#turn-it-off","content":"Turn it off"},"8102":{"id":"/docs/crash-reports-4","page_id":"/docs/crash-reports","type":"heading","tags":[],"url":"/docs/crash-reports#look-before-it-is-sent","content":"Look before it is sent"},"8103":{"id":"/docs/crash-reports-5","page_id":"/docs/crash-reports","type":"heading","tags":[],"url":"/docs/crash-reports#check-that-reporting-works","content":"Check that reporting works"},"8104":{"id":"/docs/crash-reports-6","page_id":"/docs/crash-reports","type":"heading","tags":[],"url":"/docs/crash-reports#where-reports-are-kept","content":"Where reports are kept"},"8105":{"id":"/docs/crash-reports-7","page_id":"/docs/crash-reports","type":"heading","tags":[],"url":"/docs/crash-reports#not-covered","content":"Not covered"},"8106":{"id":"/docs/crash-reports-8","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports","content":"If a `stlabs` command stops unexpectedly, it prints a short message instead of a stack trace, saves a report on your\ncomputer, and, unless you have turned it off, sends the same report to STLabs. This page lists\nexactly what is in it."},"8107":{"id":"/docs/crash-reports-9","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#what-a-report-contains","content":"A random id, made once for this installation. It is not your name, but it links the reports\nfrom this computer to each other, including across different sign-ins. It changes if you delete\nthe `stlabs` folder in your config directory."},"8108":{"id":"/docs/crash-reports-10","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#what-a-report-contains","content":"A random id for the report itself."},"8109":{"id":"/docs/crash-reports-11","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#what-a-report-contains","content":"The `stlabs` version, the API version it was built for, your operating system, your chip type and\nthe Python version it was built with."},"8110":{"id":"/docs/crash-reports-12","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#what-a-report-contains","content":"The command you ran and the names of the options you gave it, such as `tickets update --title`.\nOnly names that `stlabs` itself defines are included."},"8111":{"id":"/docs/crash-reports-13","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#what-a-report-contains","content":"The kind of error, and the places in the `stlabs` program where it happened, as names and line\nnumbers."},"8112":{"id":"/docs/crash-reports-14","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#what-a-report-contains","content":"If the crash was in the HTTP engine that `stlabs` runs, the signal that ended it or its exit code, and whether it ended in a panic. The text of the panic is not sent."},"8113":{"id":"/docs/crash-reports-15","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#what-a-report-contains","content":"When the API had refused a request just before the crash: the request id, the status and the\nerror code."},"8114":{"id":"/docs/crash-reports-16","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#what-a-report-contains","content":"The time."},"8115":{"id":"/docs/crash-reports-17","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#what-a-report-contains","content":"The report is sent while you are signed in, so STLabs also sees which organization and which\nperson it came from."},"8116":{"id":"/docs/crash-reports-18","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#what-it-never-contains","content":"The values of the arguments and options you typed, such as ticket text and ids. Anything the API\nsent back, other than the request id, status and error code listed above. Your token, headers, environment variables, file paths, or the text of the\nerror message."},"8117":{"id":"/docs/crash-reports-19","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#turn-it-off","content":"Set `STLABS_TELEMETRY=0` or `DO_NOT_TRACK=1` to turn off crash reports and the daily update check. Reports then\nstay on your computer. API calls you make are logged by the service as usual. Nothing is sent until `stlabs` has shown you the one-time notice about this page, on a terminal. A\nscript or a CI machine where nobody has run `stlabs` at a terminal has never shown it. A report from a crash\nbefore the notice has been shown is saved, and the message says: \"Saved: stlabs sends crash reports after\nshowing its notice once in a terminal.\" When the notice is shown, `stlabs` also says how many saved reports it\nis about to send, for example \"stlabs saved 1 crash report from earlier and will send it after this command, if it works.\", and how to turn\nreports off. If you are signed in and have an organization set, it sends them after the command, if it works;\notherwise it says they will go after you sign in, set an organization, or both. If reports are off, they are never\nsent, and a waiting report older than 7 days is dropped. After the notice has been shown, reports are sent unless you\nturn them off as above.\nA build that is not a release, such as one made from source, never sends. `STLABS_NO_NOTICES=1` hides notices only. It does not stop reports, and on a computer that has\nnever shown the notice it keeps the notice from ever being shown, so nothing is sent there."},"8118":{"id":"/docs/crash-reports-20","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#look-before-it-is-sent","content":"Set `STLABS_TELEMETRY=print` and `stlabs` prints the report after the message and sends\nnothing."},"8119":{"id":"/docs/crash-reports-21","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#check-that-reporting-works","content":"Run `STLABS_CRASH_TEST=1 stlabs --version`. `stlabs` stops on purpose with an error named\n`CrashTest`, and the message, the saved file and the report follow the rules above. It is the one\nway to see a report made and sent without waiting for a real problem, so it also needs the\none-time notice to have been shown, and you to be signed in."},"8120":{"id":"/docs/crash-reports-22","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#where-reports-are-kept","content":"In the `crash-reports` folder next to your `stlabs` config file, which is `~/.config/stlabs` by\ndefault. The message tells you the file to attach if you write to support@stlabs.com. The 20 newest\nfiles are kept, and a report that was sent within the last hour is kept as well, whatever\nits age in the list, because it is what stops the same crash being sent twice. A report made when you were not signed in or had no organization set (run\n`stlabs org set <slug>`), or that could not be delivered because of a network problem or a\ntemporary error, waits there and is tried again on later runs, unless it\nis more than 7 days old or was made for a different API address. A report that STLabs refuses stays\nonly on your computer. At most one report of the same kind of crash is sent per hour; the others\nstay on your computer. Delete the folder at any time."},"8121":{"id":"/docs/crash-reports-23","page_id":"/docs/crash-reports","tags":[],"type":"text","url":"/docs/crash-reports#not-covered","content":"`stlabs raw` is a developer-only command in a source checkout. It replaces the `stlabs` process\nwith the engine, so a crash there is not reported."},"8122":{"id":"/docs/install","page_id":"/docs/install","type":"page","content":"Install","breadcrumbs":["Docs"],"tags":[],"url":"/docs/install"},"8123":{"id":"/docs/install-0","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install","content":"One line, nothing else to install."},"8124":{"id":"/docs/install-1","page_id":"/docs/install","type":"heading","tags":[],"url":"/docs/install#about","content":"About"},"8125":{"id":"/docs/install-2","page_id":"/docs/install","type":"heading","tags":[],"url":"/docs/install#install","content":"Install"},"8126":{"id":"/docs/install-3","page_id":"/docs/install","type":"heading","tags":[],"url":"/docs/install#usage","content":"Usage"},"8127":{"id":"/docs/install-4","page_id":"/docs/install","type":"heading","tags":[],"url":"/docs/install#update-and-uninstall","content":"Update and uninstall"},"8128":{"id":"/docs/install-5","page_id":"/docs/install","type":"heading","tags":[],"url":"/docs/install#read-on","content":"Read on"},"8129":{"id":"/docs/install-6","page_id":"/docs/install","type":"heading","tags":[],"url":"/docs/install#questions-and-support","content":"Questions and support"},"8130":{"id":"/docs/install-7","page_id":"/docs/install","type":"heading","tags":[],"url":"/docs/install#license","content":"License"},"8131":{"id":"/docs/install-8","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#about","content":"stlabs is the command line for Standard Template Labs (STLabs)."},"8132":{"id":"/docs/install-9","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#about","content":"Read, search, create and update tickets without leaving the shell."},"8133":{"id":"/docs/install-10","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#about","content":"Script it: JSON out, exit codes, safe retries with an idempotency key."},"8134":{"id":"/docs/install-11","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#about","content":"One folder per platform, no runtime to install."},"8135":{"id":"/docs/install-12","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#about","content":"Built from the same API description as the service, so it never drifts."},"8136":{"id":"/docs/install-13","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#install","content":"stlabs is available for macOS (Apple silicon) and Linux (x86_64)."},"8137":{"id":"/docs/install-14","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#install","content":"The script fetches this platform's build, checks it against the release's checksums, and by default unpacks it under `~/.local/share/stlabs` and links `~/.local/bin/stlabs`. It edits no shell files; if `~/.local/bin` is not on your PATH, it prints the line to add. To install a release candidate, name its version: end the command with `sh -s -- --version <version>`."},"8138":{"id":"/docs/install-15","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#install","content":"Check the install with `stlabs --version`."},"8139":{"id":"/docs/install-16","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#install","content":"<Callout type=\"warn\" title=\"macOS\">macOS may block the first run of an unsigned app. If it does, open System Settings, Privacy & Security, and choose Open Anyway.</Callout>"},"8140":{"id":"/docs/install-17","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#usage","content":"**List and read.** On a terminal a list is a table; everything else is JSON."},"8141":{"id":"/docs/install-18","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#usage","content":"Example output of tickets get --output json"},"8142":{"id":"/docs/install-19","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#usage","content":"**Create and update.** Fields go in one argument of `name: value` pairs."},"8143":{"id":"/docs/install-20","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#usage","content":"**Script it.** Piped or redirected output is JSON, one record per command, so pipe it into jq or capture it. A command that fails exits with a code that says why."},"8144":{"id":"/docs/install-21","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#update-and-uninstall","content":"Update: run the install line again. It installs the newest release and keeps the one before it. If you installed the agent skill, run `stlabs setup` again to update it."},"8145":{"id":"/docs/install-22","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#update-and-uninstall","content":"Uninstall: run `stlabs logout`, then remove `~/.local/share/stlabs`, `~/.local/bin/stlabs` (the default locations) and `~/.config/stlabs`. If you installed the agent skill, also remove its `stlabs-cli` folder wherever it is installed, such as in `~/.claude/skills` or `~/.agents/skills`."},"8146":{"id":"/docs/install-23","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#read-on","content":"<Card icon=\"Terminal\" title=\"Command line guide\" href=\"/docs/command-line/\">Sign in, do everyday tasks, script with output and exit codes, and fix common problems.</Card>"},"8147":{"id":"/docs/install-24","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#read-on","content":"<Card icon=\"BookOpen\" title=\"API reference\" href=\"/docs/api/2026-09-14/\">Each operation with its parameters, request and response fields and error codes.</Card>"},"8148":{"id":"/docs/install-25","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#read-on","content":"<Card icon=\"Package\" title=\"Releases\" href=\"https://github.com/Standard-Template-Labs/cli/releases\" external>every build, with checksums and notices.</Card>"},"8149":{"id":"/docs/install-26","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#questions-and-support","content":"Questions, access requests and problems: support@stlabs.com."},"8150":{"id":"/docs/install-27","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#questions-and-support","content":"Security issues: security@stlabs.com, see https://stlabs.com/security."},"8151":{"id":"/docs/install-28","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#license","content":"The stlabs binary is Standard Template Labs (STLabs) software, under the terms at https://stlabs.com/terms. The open source software bundled in it is listed, with its licenses, in THIRD_PARTY_NOTICES.md on each release."},"8152":{"id":"/docs/install-29","page_id":"/docs/install","tags":[],"type":"text","url":"/docs/install#license","content":"The notices for the current release: THIRD_PARTY_NOTICES.md on its page."},"8153":{"id":"/docs/notices","page_id":"/docs/notices","type":"page","content":"Update notices","breadcrumbs":["Docs"],"tags":[],"url":"/docs/notices"},"8154":{"id":"/docs/notices-0","page_id":"/docs/notices","tags":[],"type":"text","url":"/docs/notices","content":"The once a day line about a newer version or a known problem, and how to turn it off."},"8155":{"id":"/docs/notices-1","page_id":"/docs/notices","type":"heading","tags":[],"url":"/docs/notices#what-it-checks","content":"What it checks"},"8156":{"id":"/docs/notices-2","page_id":"/docs/notices","type":"heading","tags":[],"url":"/docs/notices#what-it-sends","content":"What it sends"},"8157":{"id":"/docs/notices-3","page_id":"/docs/notices","type":"heading","tags":[],"url":"/docs/notices#turn-it-off","content":"Turn it off"},"8158":{"id":"/docs/notices-4","page_id":"/docs/notices","tags":[],"type":"text","url":"/docs/notices","content":"Once a day, after a command, `stlabs` can tell you in one line that a newer version is out, that the\nversion you are running is no longer supported, or that it has a problem we know about and what to\ndo. The line goes to stderr, so it never mixes with the output a script reads, and it is not shown\nwhen the output is not a terminal or when you ask for `--output`."},"8159":{"id":"/docs/notices-5","page_id":"/docs/notices","tags":[],"type":"text","url":"/docs/notices#what-it-checks","content":"When you are signed in, `stlabs` asks STLabs for its current notice, the same way it asks for your\ntickets. We can change the notice at any time, for example to warn about a problem in a version\nwithout waiting for a new release. The check is at most once every 24 hours and gives up after a\nfew seconds. If it cannot be read, nothing fails. A notice from the last answer keeps applying for\nup to 7 days, and after that nothing is shown until it can be read again. When you are not signed\nin, nothing is asked and nothing is shown."},"8160":{"id":"/docs/notices-6","page_id":"/docs/notices","tags":[],"type":"text","url":"/docs/notices#what-it-sends","content":"The same sign in details every `stlabs` call sends: your token and your organization. It adds no\nid and nothing about your tickets."},"8161":{"id":"/docs/notices-7","page_id":"/docs/notices","tags":[],"type":"text","url":"/docs/notices#turn-it-off","content":"Set `STLABS_NO_NOTICES=1` to hide every one-line notice from `stlabs`. Set `STLABS_TELEMETRY=0` or\n`DO_NOT_TRACK=1` to turn off the daily update check and crash reports. API calls you make are logged by the\nservice as usual."},"8162":{"id":"/docs/versions","page_id":"/docs/versions","type":"page","content":"Versions","breadcrumbs":["Docs"],"tags":[],"url":"/docs/versions"},"8163":{"id":"/docs/versions-0","page_id":"/docs/versions","tags":[],"type":"text","url":"/docs/versions","content":"How the command line and the API are versioned."},"8164":{"id":"/docs/versions-1","page_id":"/docs/versions","tags":[],"type":"text","url":"/docs/versions","content":"The command line is versioned by semantic versioning; the API is versioned\nby date. They move for different reasons and never force each other."},"8165":{"id":"/docs/versions-2","page_id":"/docs/versions","tags":[],"type":"text","url":"/docs/versions","content":"Every build is made from one API version and sends it on every call. A build keeps working on\nits API version until that version is retired. New commands come with a new build."},"8166":{"id":"/docs/versions-3","page_id":"/docs/versions","tags":[],"type":"text","url":"/docs/versions","content":"A breaking change to the commands, flags, environment variables, config path or exit codes raises\nthe minor version before 1.0 and the major version from 1.0. New commands raise the minor version.\nA fix raises the patch version."},"8167":{"id":"/docs/versions-4","page_id":"/docs/versions","tags":[],"type":"text","url":"/docs/versions","content":"`stlabs --version` prints the build's version and its API version."},"8168":{"id":"/docs/versions-5","page_id":"/docs/versions","tags":[],"type":"text","url":"/docs/versions","content":"Every change is in the changelog, and we tell you before anything you use stops working. Problems: email support@stlabs.com with the request id."}},"count":8168},"sorting":{"language":"english","sortableProperties":["content","page_id","type","url"],"sortablePropertiesWithTypes":{"content":"string","page_id":"string","type":"string","url":"string"},"sorts":{"content":{"docs":{"1":6256,"2":6267,"3":6782,"4":7166,"5":6031,"6":8098,"7":5102,"8":5086,"9":5172,"10":5274,"11":4384,"12":3519,"13":6742,"14":3857,"15":4021,"16":4939,"17":3777,"18":4308,"19":5406,"20":1738,"21":2890,"22":620,"23":1570,"24":1234,"25":582,"26":2424,"27":2256,"28":2074,"29":2592,"30":1402,"31":1906,"32":6654,"33":7006,"34":6783,"35":7167,"36":6032,"37":7025,"38":5296,"39":5292,"40":4510,"41":4474,"42":4630,"43":5575,"44":4999,"45":4548,"46":4784,"47":5576,"48":5000,"49":4549,"50":4785,"51":5407,"52":368,"53":1739,"54":2244,"55":1156,"56":992,"57":968,"58":1218,"59":1228,"60":1058,"61":596,"62":1062,"63":880,"64":792,"65":434,"66":2891,"67":2764,"68":621,"69":1571,"70":1235,"71":2425,"72":2257,"73":2075,"74":2593,"75":1403,"76":1907,"77":7531,"78":5980,"79":6784,"80":7168,"81":6033,"82":7536,"83":5297,"84":5293,"85":4511,"86":4475,"87":4631,"88":5577,"89":5001,"90":4550,"91":4786,"92":5578,"93":5002,"94":4551,"95":4787,"96":5408,"97":369,"98":1740,"99":2245,"100":1157,"101":993,"102":969,"103":1229,"104":597,"105":1063,"106":881,"107":793,"108":435,"109":2892,"110":2765,"111":622,"112":1572,"113":1236,"114":2426,"115":2258,"116":2076,"117":2594,"118":1404,"119":1908,"120":5966,"121":6956,"122":7108,"123":7322,"124":6034,"125":6613,"126":5605,"127":3613,"128":4788,"129":3553,"130":5003,"131":4552,"132":4789,"133":5409,"134":370,"135":1741,"136":1064,"137":882,"138":794,"139":436,"140":2893,"141":623,"142":1573,"143":1237,"144":2427,"145":2259