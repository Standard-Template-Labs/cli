14/workflows-versions-get-25","page_id":"/docs/api/2026-09-14/workflows-versions-get","tags":[],"type":"text","url":"/docs/api/2026-09-14/workflows-versions-get#errors","content":"| Code                | HTTP status | Meaning                                                                                     |\n| ------------------- | ----------- | ------------------------------------------------------------------------------------------- |\n| `PERMISSION_DENIED` | 403         | Your account cannot take this action. Ask an administrator in your organization for access. |","table":"table-3"},"3877":{"id":"/docs/api/2026-09-14/workflows-versions-get-26","page_id":"/docs/api/2026-09-14/workflows-versions-get","tags":[],"type":"text","url":"/docs/api/2026-09-14/workflows-versions-get#errors","content":"| Code           | HTTP status | Meaning                                                                                      |\n| -------------- | ----------- | -------------------------------------------------------------------------------------------- |\n| `RATE_LIMITED` | 429         | You are sending requests too quickly. Wait as long as the response says, then send it again. |","table":"table-3"},"3878":{"id":"/docs/api/2026-09-14/workflows-versions-get-27","page_id":"/docs/api/2026-09-14/workflows-versions-get","tags":[],"type":"text","url":"/docs/api/2026-09-14/workflows-versions-get#errors","content":"| Code            | HTTP status | Meaning                                                                                |\n| --------------- | ----------- | -------------------------------------------------------------------------------------- |\n| `SCOPE_MISSING` | 403         | Your connection was not granted access to this kind of action. Reconnect and grant it. |","table":"table-3"},"3879":{"id":"/docs/api/2026-09-14/workflows-versions-get-28","page_id":"/docs/api/2026-09-14/workflows-versions-get","tags":[],"type":"text","url":"/docs/api/2026-09-14/workflows-versions-get#errors","content":"| Code              | HTTP status | Meaning                                                          |\n| ----------------- | ----------- | ---------------------------------------------------------------- |\n| `UNAUTHENTICATED` | 401         | You are not signed in, or your token has expired. Sign in again. |","table":"table-3"},"3880":{"id":"/docs/api/2026-09-14/workflows-versions-get-29","page_id":"/docs/api/2026-09-14/workflows-versions-get","tags":[],"type":"text","url":"/docs/api/2026-09-14/workflows-versions-get#errors","content":"| Code          | HTTP status | Meaning                                                  |\n| ------------- | ----------- | -------------------------------------------------------- |\n| `UNAVAILABLE` | 503         | The service is temporarily unavailable. Try again later. |","table":"table-3"},"3881":{"id":"/docs/api/2026-09-14/workflows-versions-get-30","page_id":"/docs/api/2026-09-14/workflows-versions-get","tags":[],"type":"text","url":"/docs/api/2026-09-14/workflows-versions-get#errors","content":"| Code                | HTTP status | Meaning                                                                              |\n| ------------------- | ----------- | ------------------------------------------------------------------------------------ |\n| `VALIDATION_FAILED` | 422         | Part of the request is not valid. Correct what the response names and send it again. |","table":"table-3"},"3882":{"id":"/docs/api/2026-09-14/workflows-versions-get-31","page_id":"/docs/api/2026-09-14/workflows-versions-get","tags":[],"type":"text","url":"/docs/api/2026-09-14/workflows-versions-get#errors","content":"| Code              | HTTP status | Meaning                                                                                         |\n| ----------------- | ----------- | ----------------------------------------------------------------------------------------------- |\n| `VERSION_UNKNOWN` | 400         | This API does not serve the version you asked for. Send one of the dates in published_versions. |","table":"table-3"},"3883":{"id":"/docs/api","page_id":"/docs/api","type":"page","content":"API reference","breadcrumbs":["Docs","API reference"],"tags":[],"url":"/docs/api"},"3884":{"id":"/docs/api-0","page_id":"/docs/api","tags":[],"type":"text","url":"/docs/api","content":"API version 2026-09-14"},"3885":{"id":"/docs/api-1","page_id":"/docs/api","type":"heading","tags":[],"url":"/docs/api#reading-an-error","content":"Reading an error"},"3886":{"id":"/docs/api-2","page_id":"/docs/api","type":"heading","tags":[],"url":"/docs/api#what-can-change-within-a-version","content":"What can change within a version"},"3887":{"id":"/docs/api-3","page_id":"/docs/api","type":"heading","tags":[],"url":"/docs/api#headers","content":"Headers"},"3888":{"id":"/docs/api-4","page_id":"/docs/api","type":"heading","tags":[],"url":"/docs/api#operations","content":"Operations"},"3889":{"id":"/docs/api-5","page_id":"/docs/api","type":"heading","tags":[],"url":"/docs/api#versions","content":"Versions"},"3890":{"id":"/docs/api-6","page_id":"/docs/api","tags":[],"type":"text","url":"/docs/api","content":"The STLabs API lets you work with tickets, queues, workflows, approvals, people and access. This reference describes the API version shown above. Versions are handled for you: the command line pins the version it was built for. If you call the API directly, send the STLabs-Version header on every request. A request without it is answered on 2026-09-14, the default date."},"3891":{"id":"/docs/api-7","page_id":"/docs/api","tags":[],"type":"text","url":"/docs/api#reading-an-error","content":"An error is a problem body. Read it in this order:"},"3892":{"id":"/docs/api-8","page_id":"/docs/api","tags":[],"type":"text","url":"/docs/api#reading-an-error","content":"`code`: what went wrong. Branch on it."},"3893":{"id":"/docs/api-9","page_id":"/docs/api","tags":[],"type":"text","url":"/docs/api#reading-an-error","content":"`reason`: why, when there is one. A reason you do not know means the code alone."},"3894":{"id":"/docs/api-10","page_id":"/docs/api","tags":[],"type":"text","url":"/docs/api#reading-an-error","content":"`next_steps`: what to do next. Ignore a kind you do not know."},"3895":{"id":"/docs/api-11","page_id":"/docs/api","tags":[],"type":"text","url":"/docs/api#reading-an-error","content":"`param`: the input it is about."},"3896":{"id":"/docs/api-12","page_id":"/docs/api","tags":[],"type":"text","url":"/docs/api#reading-an-error","content":"`retryable`: whether to send the same request again, with the same idempotency key. It is advice for this response only. A change that may already have been saved is never marked retryable: check whether it took effect first."},"3897":{"id":"/docs/api-13","page_id":"/docs/api","tags":[],"type":"text","url":"/docs/api#reading-an-error","content":"`detail` and `hint` are for people and may change in any release. Do not match on them."},"3898":{"id":"/docs/api-14","page_id":"/docs/api","tags":[],"type":"text","url":"/docs/api#what-can-change-within-a-version","content":"A version keeps its shape. Within it we may add endpoints, optional inputs, response fields, error codes and new values to lists such as states, and we may stop returning an error code. Build your integration to ignore response fields it does not know, to accept a list value it does not recognise (a new state, for example) without failing, and to handle an error code it does not recognise by its HTTP status. A field whose description says it has fixed values has a set that does not grow within a version: a new value there comes with a new dated version, except for a fix for a security problem."},"3899":{"id":"/docs/api-15","page_id":"/docs/api","tags":[],"type":"text","url":"/docs/api#what-can-change-within-a-version","content":"A change that would break an integration built that way gets a new dated version. The old version keeps working for 12 months after the new one is released, and we tell you the same day."},"3900":{"id":"/docs/api-16","page_id":"/docs/api","tags":[],"type":"text","url":"/docs/api#what-can-change-within-a-version","content":"The exceptions are a fix for a security problem, and a fix for an input that already failed or that nobody sent in the last 30 days. We may make either on the current version."},"3901":{"id":"/docs/api-17","page_id":"/docs/api","tags":[],"type":"text","url":"/docs/api#what-can-change-within-a-version","content":"Base URL: `https://api.stlabs.com/v1`"},"3902":{"id":"/docs/api-18","page_id":"/docs/api","tags":[],"type":"text","url":"/docs/api#headers","content":"The command line sends these for you, the idempotency key on writes. If you call the API directly, send them yourself:"},"3903":{"id":"/docs/api-19","page_id":"/docs/api","tags":[],"type":"text","url":"/docs/api#headers","content":"| Header                | Description                                                                                   |\n| --------------------- | --------------------------------------------------------------------------------------------- |\n| `STLabs-Organization` | The slug of the organization this request acts on. Every authenticated request must name one. |","table":"table-0"},"3904":{"id":"/docs/api-20","page_id":"/docs/api","tags":[],"type":"text","url":"/docs/api#headers","content":"| Header           | Description                                                                                                                  |\n| ---------------- | ---------------------------------------------------------------------------------------------------------------------------- |\n| `STLabs-Version` | The API version to answer on. Omit it and the API's default version answers; every response names the version that answered. |","table":"table-0"},"3905":{"id":"/docs/api-21","page_id":"/docs/api","tags":[],"type":"text","url":"/docs/api#headers","content":"| Header            | Description                                                                                                                                                        |\n| ----------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `Idempotency-Key` | 1-255 visible ASCII characters, chosen by you, so a retry cannot duplicate this. Sending the same key with the same arguments returns the original result for 24h. |","table":"table-0"},"3906":{"id":"/docs/api-22","page_id":"/docs/api","tags":[],"type":"text","url":"/docs/api#operations","content":"Add a comment to a ticket `/tickets/{ticket}/comments`"},"3907":{"id":"/docs/api-23","page_id":"/docs/api","tags":[],"type":"text","url":"/docs/api#operations","content":"Add someone to a queue `/queues/{queue}/operators/{person}`"},"3908":{"id":"/docs/api-24","page_id":"/docs/api","tags":[],"type":"text","url":"/docs/api#operations","content":"Answer a form `/approvals/{approval}:submit`"},"3909":{"id":"/docs/api-25","page_id":"/docs/api","tags":[],"type":"text","url":"/docs/api#operations","content":"Approve an approval `/approvals/{approval}:approve`"},"3910":{"id":"/docs/api-26","page_id":"/docs/api","tags":[],"type":"text","url":"/docs/api#operations","content":"Change a comment you wrote `/tickets/{ticket}/comments/{comment}`"},"3911":{"id":"/docs/api-27","page_id":"/docs/api","tags":[],"type":"text","url":"/docs/api#operations","content":"Change a queue `/queues/{queue}`"},"3912":{"id":"/docs/api-28","page_id":"/docs/api","tags":[],"type":"text","url":"/docs/api#operations","content":"Change a ticket's fields `/tickets/{ticket}`"},"3913":{"id":"/docs/api-29","page_id":"/docs/api","tags":[],"type":"text","url":"/docs/api#operations","content":"Change many tickets at once `/tickets:bulk_update`"},"3914":{"id":"/docs/api-30","page_id":"/docs/api","tags":[],"type":"text","url":"/docs/api#operations","content":"C